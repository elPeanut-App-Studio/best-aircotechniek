---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import pageHeroPhoto from '../../assets/photos/page-hero-woning.jpg';
import { locationsEn, buildLocationFaqEn, type LocationEn } from '../../data/locations-en';
import { brands } from '../../data/brands';
import { site } from '../../data/site';

export function getStaticPaths() {
  return locationsEn.map((loc) => ({ params: { stad: loc.slug }, props: { loc } }));
}

interface Props {
  loc: LocationEn;
}

const { loc } = Astro.props;
const faq = buildLocationFaqEn(loc);
const others = locationsEn.filter((l) => l.slug !== loc.slug);

const facts = [
  { label: 'Price', value: `from ${site.priceFrom}`, note: 'basic single-split, incl. VAT and installation' },
  { label: 'Brands', value: 'Daikin · LG · AUX', note: 'reliable brands' },
  { label: 'Warranty', value: '2 to 5 years', note: 'on the unit, by brand' },
  { label: 'Response', value: 'within 24 hours', note: 'after your request' },
];

const approach = [
  {
    title: 'Advice at your home',
    description: `We visit you in ${loc.city} to look at the space and together determine the right capacity and the best position for the units.`,
  },
  {
    title: 'Expert installation',
    description:
      'Our installers mount your system neatly, safely and to code. We leave your home clean.',
  },
  {
    title: 'Warranty and aftercare',
    description:
      'You get 2 to 5 years manufacturer warranty on the unit depending on the brand, plus 2 years on the installation with annual maintenance. We remain your point of contact.',
  },
];
---

<BaseLayout
  lang="en"
  title={`Air conditioning installation ${loc.city} from ${site.priceFrom} | Best Aircotechniek`}
  description={loc.metaDescription}
>
  <PageHero
    title={`Air conditioning installation in ${loc.city}`}
    description={loc.heroDescription}
    image={pageHeroPhoto}
  />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <nav class="mb-8 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/en/air-conditioning-installation-noord-brabant" class="hover:text-brand-700">
          Service area Noord-Brabant
        </a>
        <span class="mx-2">/</span>
        <span class="text-slate-700">{loc.city}</span>
      </nav>

      <div class="grid gap-12 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <div class="gold-accent-line"></div>
          <h2 class="section-heading mt-6">Having air conditioning installed in {loc.city}</h2>
          {loc.intro.map((p) => <p class="mt-4 text-lg leading-relaxed text-slate-600">{p}</p>)}

          <a href="/en/contact" class="btn-primary mt-8 inline-flex">Request a free quote</a>
        </div>

        <aside class="lg:col-span-1">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gold-600">In short</h3>
            <dl class="mt-4 space-y-4">
              {
                facts.map((f) => (
                  <div class="border-b border-slate-200 pb-3 last:border-0 last:pb-0">
                    <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">{f.label}</dt>
                    <dd class="text-lg font-bold text-brand-900">{f.value}</dd>
                    <dd class="text-sm text-slate-500">{f.note}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading text-center">How we work in {loc.city}</h2>
      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        {
          approach.map((step) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
              <h3 class="text-lg font-semibold text-slate-900">{step.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{step.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading">Brands we install in {loc.city}</h2>
      <p class="section-subheading">
        We are an installer for Daikin, LG and AUX. View the models and specifications per brand.
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        {
          brands.map((b) => (
            <a
              href={`/en/brands/${b.slug}`}
              class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-gold-400 hover:shadow-md"
            >
              <span class="text-lg font-bold text-brand-900">{b.name} in {loc.city}</span>
              <span class="mt-4 text-sm font-semibold text-brand-700" aria-hidden="true">
                View {b.name} &rarr;
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-brand-200 bg-brand-50 p-8 sm:p-12">
        <div class="gold-accent-line"></div>
        <h2 class="section-heading mt-6">Also working around {loc.city}</h2>
        <p class="section-subheading">
          Besides {loc.city} we are active in {loc.nearby.join(', ')} among others. You can also view our full
          <a href="/en/air-conditioning-installation-noord-brabant" class="font-semibold text-brand-700 underline">service area in Noord-Brabant</a>.
        </p>
        <ul class="mt-8 flex flex-wrap gap-3">
          {
            others.map((l) => (
              <li>
                <a
                  href={`/en/air-conditioning-installation-${l.slug}`}
                  class="inline-flex items-center rounded-full border border-brand-200 bg-white px-4 py-2 text-sm font-semibold text-brand-800 transition hover:border-gold-400 hover:text-brand-900"
                >
                  {l.city}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="section-heading">Frequently asked questions about {loc.city}</h2>
      <div class="mt-10">
        <FaqAccordion items={faq} />
      </div>
    </div>
  </section>

  <FaqSchema items={faq} />

  <CTASection
    lang="en"
    title={`Air conditioning installed in ${loc.city}?`}
    description="Get in touch for free advice or a tailored quote. We respond within 24 hours."
  />
</BaseLayout>
