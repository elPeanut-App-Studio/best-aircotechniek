---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import JourneyInteractive from '../../components/JourneyInteractive.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import PageHero from '../../components/PageHero.astro';
import heroPhoto from '../../assets/photos/aux-buitenunit-installatie.jpg';
import { journeyEn, journeyIntroEn } from '../../data/journey-en';
import { processFaqEn } from '../../data/faq-en';
---

<BaseLayout
  lang="en"
  title="Having air conditioning installed: how it works | Best Aircotechniek"
  description="Six clear steps from advice to installation. See how Best Aircotechniek installs your air conditioning in Best, Eindhoven and the surrounding area."
>
  <PageHero
    title={journeyIntroEn.title}
    description={journeyIntroEn.description}
    image={heroPhoto}
  />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-12">
        <div class="max-w-3xl">
          <div class="gold-accent-line"></div>
          <h2 class="section-heading mt-6">Your customer journey</h2>
          <p class="section-subheading">
            We guide you personally through the whole process. No call centre and no vague agreements. Clear
            communication and craftsmanship instead, in English throughout.
          </p>
          <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <div class="rounded-2xl border border-brand-100 bg-brand-50 p-6 sm:min-w-[16rem]">
              <p class="text-sm font-semibold text-brand-900">Average lead time</p>
              <p class="mt-1 text-2xl font-bold text-brand-800">1 to 2 weeks</p>
              <p class="mt-2 text-sm text-slate-600">
                From quote to installation, depending on your situation and our schedule.
              </p>
            </div>
            <a href="/en/contact/" class="btn-primary inline-flex shrink-0">Start your request</a>
          </div>
        </div>

        <JourneyInteractive steps={journeyEn} lang="en" />
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="section-heading">Frequently asked questions</h2>
      <div class="mt-10">
        <FaqAccordion items={processFaqEn} />
      </div>
    </div>
  </section>

  <FaqSchema items={processFaqEn} />

  <CTASection
    lang="en"
    title="Ready to get started?"
    description="Get in touch and we will take you through step 1. Free and without obligation."
  />
</BaseLayout>
