---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import heroPhoto from '../../assets/photos/modern-woning-airco.jpg';

const documents = [
  {
    subtitle: 'Product brochure',
    title: 'Daikin air conditioning',
    description:
      'Overview of the Daikin wall-mounted models Sensira, Comfora, Perfera, Stylish and Emura: features, energy labels (SEER/SCOP) and which capacity suits which room.',
    href: '/daikin-airco-brochure-en.pdf',
    meta: 'PDF · 5 pages',
  },
  {
    subtitle: 'Product brochure',
    title: 'AUX air conditioning',
    description:
      'Overview of the AUX wall-mounted models Freedom, Q-smart and C-smart: features, energy labels (SEER/SCOP) and which capacity suits which room.',
    href: '/aux-airco-brochure-en.pdf',
    meta: 'PDF · 5 pages',
  },
  {
    subtitle: 'Product brochure',
    title: 'LG air conditioning',
    description:
      'Overview of the LG wall-mounted models Standard Plus, AI AIR Special, Deluxe and Premium: features, energy labels (SEER/SCOP) and which capacity suits which room.',
    href: '/lg-airco-brochure-en.pdf',
    meta: 'PDF · 5 pages',
  },
];
---

<BaseLayout
  lang="en"
  title="Brochures and downloads | Best Aircotechniek"
  description="Download our brochures and documents in English. See the AUX and LG product brochures with all models, features and capacities."
>
  <PageHero
    title="Brochures and downloads"
    description="View and download our brochures and documents. We install Daikin, LG, AUX and Mitsubishi Heavy Industries air conditioners; new documents will be added here."
    image={heroPhoto}
  />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="gold-accent-line"></div>
      <h2 class="section-heading mt-6">Available documents</h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-600">
        All files are free to download as pdf. Do you need a document or a tailored quote?
        <a href="/en/contact/" class="font-semibold text-brand-700 underline">Get in touch</a>.
      </p>

      <div class="mt-10 space-y-5">
        {
          documents.map((doc) => (
            <div class="panel flex flex-col gap-5 p-6 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex items-start gap-4">
                <span
                  class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700"
                  aria-hidden="true"
                >
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 0H6.375c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h11.25c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"
                    />
                  </svg>
                </span>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider text-gold-600">{doc.subtitle}</p>
                  <h3 class="text-xl font-bold text-brand-900">{doc.title}</h3>
                  <p class="mt-2 leading-relaxed text-slate-600">{doc.description}</p>
                  <p class="mt-2 text-sm text-slate-400">{doc.meta}</p>
                </div>
              </div>
              <a
                href={doc.href}
                download
                class="btn-primary inline-flex shrink-0 items-center gap-2 self-start sm:self-auto"
              >
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
                Download
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    lang="en"
    title="Need help choosing?"
    description="We are happy to advise you on the right brand, model and capacity. Request a free quote."
  />
</BaseLayout>
