---
/**
 * Engelse spiegel van /merken/vergelijken.
 *
 * De tabel en de keuzekaarten komen uit hetzelfde BrandComparison-component met
 * lang="en", dus die kunnen niet uiteenlopen met de Nederlandse pagina. Alleen
 * de FAQ staat hier apart, omdat die ook de FAQPage-structuurdata vult.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTASection from '../../../components/CTASection.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import FaqSchema from '../../../components/FaqSchema.astro';
import BrandComparison from '../../../components/BrandComparison.astro';
import { merkVergelijking, naarEngels } from '../../../data/brand-comparison';
import { site } from '../../../data/site';
import pageHeroPhoto from '../../../assets/photos/page-hero-woning.jpg';

const [aux, lg, daikin] = merkVergelijking;

const faq = [
  {
    question: 'Which air conditioning brand is the most efficient?',
    answer: `LG reaches the highest efficiency in our range, with a SEER up to ${naarEngels(lg.seer).split(' to ')[1]} and an energy label up to ${lg.labelKoelen}. Daikin sits just below that but has a wider range. AUX is the least efficient of the three, and that is exactly why it is the cheapest to buy. Whether that difference pays back depends on how many hours a year you use the unit; for a bedroom that only cools in summer, the purchase price weighs more heavily than the efficiency.`,
  },
  {
    question: 'Is an AUX as good as an LG or a Daikin?',
    answer: `For most homes, yes. An AUX runs on the same R32 refrigerant and the same inverter technology as LG and Daikin, and reaches energy label ${aux.labelKoelen} for cooling. The difference is at the top of the efficiency range and in the warranty term: two years of manufacturer warranty against five for LG and Daikin. That is why we call AUX the best value for money of the three, and not simply the cheapest.`,
  },
  {
    question: 'What is the difference in warranty between the brands?',
    answer:
      'LG and Daikin give five years of manufacturer warranty, AUX two years. On top of that we give two years of warranty on the installation itself, whatever the brand. The manufacturer warranty requires the unit to be serviced yearly by a qualified installer.',
  },
  {
    question: 'Which brand suits a large or high room?',
    answer: `Daikin has the finest capacity steps, from ${naarEngels(daikin.vermogens)}, so there is almost always a version that fits exactly. AUX and LG go up to 7.0 kW. Note with LG: the AI Air Special and Premium only exist as 2.5 and 3.5 kW, so for a large living room that leaves Standard Plus and Deluxe.`,
  },
  {
    question: 'Why is there no from-price for LG and Daikin?',
    answer: `For AUX we have fixed from-prices per model, starting at ${site.priceFromEn} including VAT and installation. For LG and Daikin the price depends more on the model and the installation situation, and we would rather not put a figure on the site that turns out not to apply in your case. You receive a quote with a fixed price within 24 hours.`,
  },
];
---

<BaseLayout
  lang="en"
  title="Compare AUX, LG and Daikin | Best Aircotechniek"
  description="AUX, LG and Daikin side by side: capacities, SEER and SCOP, energy label, warranty and price. With the strong point and the downside per brand."
>
  <PageHero
    title="Comparing AUX, LG and Daikin"
    description="The same figures side by side, so you can see where the brands really differ."
    image={pageHeroPhoto}
  />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <BrandComparison lang="en" />

      <div class="mt-16">
        <h2 class="section-heading">Frequently asked questions about choosing</h2>
        <div class="mt-8">
          <FaqAccordion items={faq} />
        </div>
      </div>
    </div>
  </section>

  <FaqSchema items={faq} />

  <CTASection
    lang="en"
    title="Which brand suits your home?"
    description={`We visit, calculate the capacity for your room and advise honestly which brand fits. A complete installation starts at ${site.priceFromEn}.`}
  />
</BaseLayout>
