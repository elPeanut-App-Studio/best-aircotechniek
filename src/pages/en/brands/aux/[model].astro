---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import CTASection from '../../../../components/CTASection.astro';
import { auxModels, auxSizes, auxShared } from '../../../../data/aux-products';
import pageHeroPhoto from '../../../../assets/photos/page-hero-woning.jpg';
import { auxTextEn, sharedEn, sizeRoomEn, num } from '../../../../i18n/products-en';
import PriceSticker from '../../../../components/PriceSticker.astro';
import ProductSchema from '../../../../components/ProductSchema.astro';
import { acSpecs } from '../../../../lib/schema-specs';

export function getStaticPaths() {
  return auxModels.map((model) => ({ params: { model: model.slug }, props: { model } }));
}

const rawModel = Astro.props.model;
const model = { ...rawModel, ...auxTextEn[rawModel.slug] };

// Iconen voor de 5 modelkenmerken (zelfde volgorde als model.specs)
const specIcons = ['swing', 'luchtzuivering', 'zelfreiniging', 'verwarmen', 'design'];
const schemaSpecs = acSpecs({
  lang: 'en', seer: model.seer, scop: model.scop,
  labelKoelen: model.labelKoelen, labelVerwarmen: model.labelVerwarmen, warranty: '2 years',
});
---

<BaseLayout
  lang="en"
  title={`AUX ${model.name} air conditioning installed | Best Aircotechniek`}
  description={`AUX ${model.name}: ${model.intro} Beschikbaar in 2,5 / 3,5 / 5,0 / 7,0 kW. Laten installeren door Best Aircotechniek.`}
>
  <PageHero title={`AUX ${model.name}`} description={model.intro} image={pageHeroPhoto} />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/en/brands/aux" class="hover:text-brand-700">AUX</a>
        <span class="px-1">/</span>
        <span class="text-slate-700">{model.name}</span>
      </nav>

      <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-stretch">
        <div class="panel relative min-h-[22rem] overflow-hidden bg-gradient-to-br from-brand-50 via-white to-white lg:col-span-7">
          <img src={model.photo} alt={`AUX ${model.name} air conditioner`} width="900" height="900" loading="eager" class="absolute inset-0 h-full w-full object-cover" />
          <PriceSticker amount={model.priceFrom} lang="en" size="lg" class="right-5 top-5 sm:right-7 sm:top-7" />
        </div>
        <div class="panel flex flex-col p-6 sm:p-8 lg:col-span-5">
          <p class="text-sm font-semibold uppercase tracking-wider text-gold-600">{model.tier}</p>
          <h2 class="section-heading mt-2">Features</h2>
          <dl class="mt-6 space-y-4">
            <div class="flex items-start gap-3">
              <img src="/spec-icons/rendement.png" alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
              <div>
                <dt class="text-sm text-slate-500">SEER (up to) / SCOP</dt>
                <dd class="font-semibold text-brand-900">{num(model.seer)} / {num(model.scop)}</dd>
              </div>
            </div>
            {
              model.specs.map((s, i) => (
                <div class="flex items-start gap-3">
                  <img src={`/spec-icons/${specIcons[i]}.png`} alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
                  <div>
                    <dt class="text-sm text-slate-500">{s.label}</dt>
                    <dd class="font-semibold text-brand-900">{s.value}</dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="mt-8 rounded-2xl bg-brand-950 px-6 py-6 text-white shadow-card sm:px-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-gold-400">Standard on every AUX</p>
        <div class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-4">
          {
            sharedEn['aux'].map((item) => (
              <span class="flex items-start gap-2 text-sm text-brand-100">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-gold-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                {item}
              </span>
            ))
          }
        </div>
      </div>

      <h2 class="section-heading mt-16">Available capacities</h2>
      <p class="mt-3 text-slate-600">Choose the capacity that suits your room. Click through for all the details.</p>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          auxSizes.map((size) => (
            <a
              href={`/en/brands/aux/${model.slug}/${size.slug}`}
              class="group card-link flex flex-col p-6"
            >
              <p class="text-2xl font-bold text-brand-900">{num(size.kw)}</p>
              <p class="mt-2 min-h-[2.5rem] text-sm text-slate-600">{sizeRoomEn[size.slug] ?? size.room}</p>
              <p class="mt-1 text-sm text-slate-500">{num(size.volume)} · {num(size.area)}</p>
              <span class="mt-auto pt-4 text-sm font-semibold text-brand-700 transition group-hover:text-brand-900">
                View details
                <span aria-hidden="true" class="transition group-hover:translate-x-0.5">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    title={`Interesse in de AUX ${model.name}?`}
    description="We are happy to advise you on the right capacity and take care of the complete installation. Request a free quote with no obligation."
  />
  <ProductSchema
    lang="en"
    name={`AUX ${model.name} air conditioner`}
    brand="AUX"
    description={`AUX ${model.name}: ${model.intro} Available in ${auxSizes.length} capacities, SEER up to ${num(model.seer)} and SCOP ${num(model.scop)}, energy label ${model.labelKoelen} for cooling and ${model.labelVerwarmen} for heating.`}
    image={model.photo}
    specs={schemaSpecs}
    priceFrom={rawModel.priceFrom}
  />
</BaseLayout>
