---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../../components/CTASection.astro';
import { lgModels, lgSizesFor, lgCapacity } from '../../../../../data/lg-products';
import { coolingLabel, heatingLabel } from '../../../../../data/energy-labels';
import { site } from '../../../../../data/site';
import { lgTextEn, sharedEn, sizeRoomEn, num } from '../../../../../i18n/products-en';

export function getStaticPaths() {
  return lgModels.flatMap((model) =>
    lgSizesFor(model.slug).map((size) => ({ params: { model: model.slug, size: size.slug }, props: { model, size } })),
  );
}

const rawModel = Astro.props.model;
const size = Astro.props.size;
const roomEn = sizeRoomEn[size.slug] ?? size.room;
const model = { ...rawModel, ...lgTextEn[rawModel.slug] };
const cap = lgCapacity(rawModel.slug, size.slug)!;
const labelKoelen = coolingLabel(cap.seer);
const labelVerwarmen = heatingLabel(cap.scop);

// Data voor de client-side wisselaar (scrollpositie blijft behouden)
const sizesData = lgSizesFor(rawModel.slug).map((s) => {
  const c = lgCapacity(rawModel.slug, s.slug)!;
  return {
    slug: s.slug,
    kw: num(s.kw),
    volume: num(s.volume),
    area: num(s.area),
    room: sizeRoomEn[s.slug] ?? s.room,
    typeCode: c.code,
    koel: `${num(c.koel)} kW`,
    verw: `${num(c.verw)} kW`,
    max: `${num(c.koelMax)} kW cooling / ${num(c.verwMax)} kW heating`,
    seer: num(c.seer),
    scop: num(c.scop),
    labelKoelen: coolingLabel(c.seer),
    labelVerwarmen: heatingLabel(c.scop),
  };
});

const rows = [
  { icon: 'koelen', label: 'Cooling capacity (nominal)', value: `${num(cap.koel)} kW`, badge: labelKoelen, badgeId: 'val-label-koelen', id: 'val-koel' },
  { icon: 'verwarmen', label: 'Heating capacity (nominal)', value: `${num(cap.verw)} kW`, badge: labelVerwarmen, badgeId: 'val-label-verwarmen', id: 'val-verw' },
  { icon: 'ruimte', label: 'Suitable for', value: `Rooms up to ${num(size.volume)}`, id: 'val-volume' },
  { icon: 'swing', label: 'Floor area (rule of thumb)', value: num(size.area), id: 'val-area' },
  { icon: 'rendement', label: 'SEER / SCOP', value: `${num(cap.seer)} / ${num(cap.scop)}`, id: 'val-rendement' },
  { icon: 'luchtzuivering', label: 'Air purification', value: model.specs[0].value },
  { icon: 'wifi', label: 'Controls', value: 'Remote control and LG ThinQ app' },
];

const extra: { label: string; value: string; id?: string }[] = [
  { label: 'Model code', value: cap.code, id: 'val-code' },
  { label: 'Maximum output', value: `${num(cap.koelMax)} kW cooling / ${num(cap.verwMax)} kW heating`, id: 'val-max' },
  { label: 'Typical room', value: roomEn, id: 'val-room' },
  { label: 'Smart functions', value: model.specs[1].value },
  { label: 'Finish', value: model.specs[3].value },
  { label: 'Refrigerant', value: 'R32' },
  { label: 'Warranty', value: '5 year manufacturer warranty' },
];

const btnBase = 'size-btn rounded-xl px-5 py-2.5 font-semibold transition ';
const btnActive = 'border-2 border-brand-700 bg-white text-brand-900 shadow-sm';
const btnInactive = 'border border-slate-300 bg-white text-slate-700 hover:border-brand-500 hover:text-brand-900';
---

<BaseLayout
  lang="en"
  title={`LG ${model.name} ${num(size.kw)} air conditioner | Best Aircotechniek`}
  description={`LG ${model.name} ${num(size.kw)} (${cap.code}): ${num(cap.koel)} kW cooling and ${num(cap.verw)} kW heating, energy label ${labelKoelen}. Installed from ${site.priceFrom} by Best Aircotechniek.`}
>
  <section class="pt-8 pb-16 sm:pt-10 sm:pb-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/en/brands/lg" class="hover:text-brand-700">LG</a>
        <span class="px-1">/</span>
        <a href={`/en/brands/lg/${model.slug}`} class="hover:text-brand-700">{model.name}</a>
        <span class="px-1">/</span>
        <span id="crumb-size" class="text-slate-700">{num(size.kw)}</span>
      </nav>

      <div class="mt-4">
        <p class="text-sm font-semibold uppercase tracking-wider text-gold-600">{model.tier}</p>
        <h1 id="page-title" class="mt-1 text-3xl font-extrabold tracking-tight text-brand-900 sm:text-4xl">
          LG {model.name} {num(size.kw)}
        </h1>
        <p id="page-sub" class="mt-2 text-slate-600">
          Suitable for {roomEn.toLowerCase()} ({size.volume}).
        </p>
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
        <span class="text-sm font-semibold text-slate-700">Choose your capacity</span>
        <div class="flex flex-wrap gap-3">
          {
            lgSizesFor(rawModel.slug).map((s) => (
              <a
                href={`/en/brands/lg/${model.slug}/${s.slug}`}
                data-size={s.slug}
                class={btnBase + (s.slug === size.slug ? btnActive : btnInactive)}
              >
                {num(s.kw)}
              </a>
            ))
          }
        </div>
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-stretch">
        <div class="panel flex min-h-[22rem] flex-col items-center justify-center gap-5 bg-gradient-to-br from-brand-50 via-white to-white p-8 lg:col-span-7">
          <img
            src={model.photo}
            alt={`LG ${model.name} air conditioner with indoor unit, outdoor unit and remote control`}
            width="650"
            height="650"
            loading="eager"
            class="w-full max-w-[26rem] object-contain"
          />
          <div class="text-center">
            <p id="panel-title" class="text-3xl font-extrabold text-brand-900">{model.name} {num(size.kw)}</p>
            <p class="mt-4 text-sm text-slate-500">Official model code: <span id="panel-code">{cap.code}</span></p>
          </div>
        </div>

        <div class="panel flex flex-col p-6 sm:p-8 lg:col-span-5">
          <h2 class="section-heading">Specifications</h2>
          <dl class="mt-6 space-y-4">
            {
              rows.map((r) => (
                <div class="flex items-start gap-3">
                  <img src={`/spec-icons/${r.icon}.png`} alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
                  <div>
                    <dt class="text-sm text-slate-500">{r.label}</dt>
                    <dd class="flex items-center gap-2 font-semibold text-brand-900">
                      <span id={r.id}>{r.value}</span>
                      {r.badge && (
                        <span
                          id={r.badgeId}
                          class={`rounded px-2 py-0.5 text-xs font-bold text-white ${r.badge === 'A+++' ? 'bg-[#00a651]' : r.badge === 'A++' ? 'bg-[#2f9e44]' : 'bg-[#94b820]'}`}
                        >
                          {r.badge}
                        </span>
                      )}
                    </dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="panel mt-8 p-6 sm:p-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="min-w-0 flex-1">
            <h3 class="text-lg font-bold text-brand-900">More features</h3>
            <ul class="mt-4 space-y-2 text-sm">
              {
                extra.map((e) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500" />
                    <span class="text-slate-600">
                      <span class="font-semibold text-brand-900">{e.label}:</span>{' '}
                      <span id={e.id}>{e.value}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="shrink-0 lg:pl-8">
            <a href="/en/contact" class="btn-primary inline-flex w-full justify-center sm:w-auto">Request a quote</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title={`LG ${model.name} laten installeren?`}
    description={`Best Aircotechniek verzorgt advies, levering en een vakkundige montage vanaf ${site.priceFrom}. Request a free quote with no obligation.`}
  />

  <script
    define:vars={{
      sizesData,
      modelSlug: model.slug,
      modelName: model.name,
      btnBase,
      btnActive,
      btnInactive,
    }}
  >
    const links = Array.from(document.querySelectorAll('a[data-size]'));
    function applySize(slug) {
      const d = sizesData.find((s) => s.slug === slug);
      if (!d) return;
      const setText = (id, text) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };
      setText('val-koel', d.koel);
      setText('val-verw', d.verw);
      setText('val-volume', 'Rooms up to ' + d.volume);
      setText('val-area', d.area);
      setText('val-room', d.room);
      setText('val-rendement', d.seer + ' / ' + d.scop);
      setText('val-max', d.max);
      setText('val-code', d.typeCode);
      const paint = (id, v) => {
        const el = document.getElementById(id);
        if (!el || !v) return;
        el.textContent = v;
        el.className =
          'rounded px-2 py-0.5 text-xs font-bold text-white ' +
          (v === 'A+++' ? 'bg-[#00a651]' : v === 'A++' ? 'bg-[#2f9e44]' : 'bg-[#94b820]');
      };
      paint('val-label-koelen', d.labelKoelen);
      paint('val-label-verwarmen', d.labelVerwarmen);
      setText('panel-title', modelName + ' ' + d.kw);
      setText('panel-code', d.typeCode);
      setText('crumb-size', d.kw);
      setText('page-title', 'LG ' + modelName + ' ' + d.kw);
      setText('page-sub', 'Suitable for ' + d.room.toLowerCase() + ' (' + d.volume + ').');
      links.forEach((a) => {
        a.className = btnBase + (a.dataset.size === slug ? btnActive : btnInactive);
      });
      document.title = 'LG ' + modelName + ' ' + d.kw + ' air conditioner | Best Aircotechniek';
      history.replaceState(null, '', '/en/brands/lg/' + modelSlug + '/' + slug);
    }
    links.forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        applySize(a.dataset.size);
      }),
    );
  </script>
</BaseLayout>
