---
/**
 * Engelse spiegel van de MHI-modelpagina.
 *
 * Alle cijfers komen uit mhi-products.ts; alleen de teksten komen uit
 * products-en.ts. De iconen staan bij de Nederlandse specs, dus die worden hier
 * op index gekoppeld aan de Engelse labels: bij een simpele spread zou het
 * icoon verdwijnen.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import CTASection from '../../../../components/CTASection.astro';
import {
  mhiModels,
  mhiSizesFor,
  mhiBestLabels,
  mhiBestEfficiency,
} from '../../../../data/mhi-products';
import { site } from '../../../../data/site';
import { mhiTextEn, sharedEn, sizeRoomEn, num } from '../../../../i18n/products-en';
import pageHeroPhoto from '../../../../assets/photos/page-hero-woning.jpg';
import ProductSchema from '../../../../components/ProductSchema.astro';
import { acSpecs } from '../../../../lib/schema-specs';

export function getStaticPaths() {
  return mhiModels.map((model) => ({ params: { model: model.slug }, props: { model } }));
}

const rawModel = Astro.props.model;
const en = mhiTextEn[rawModel.slug];
const merk = 'Mitsubishi Heavy Industries';
const basis = '/en/brands/mitsubishi-heavy-industries';

const specs = rawModel.specs.map((s, i) => ({ icon: s.icon, ...(en.specs[i] ?? { label: s.label, value: s.value }) }));
const others = mhiModels.filter((m) => m.slug !== rawModel.slug);
const modelSizes = mhiSizesFor(rawModel.slug);
const bestLabels = mhiBestLabels(rawModel.slug);
const bestEff = mhiBestEfficiency(rawModel.slug);
const labelKleur = (label?: string) =>
  label === 'A+++' ? 'bg-[#00a651]' : label === 'A++' ? 'bg-[#2f9e44]' : 'bg-[#94b820]';
const schemaSpecs = acSpecs({
  lang: 'en',
  seer: bestEff?.seer, scop: bestEff?.scop,
  labelKoelen: bestLabels?.koelen, labelVerwarmen: bestLabels?.verwarmen,
  refrigerant: 'R32', warranty: '5 year parts warranty',
});
---

<BaseLayout
  lang="en"
  title={`${merk} ${rawModel.name} | Best Aircotechniek`}
  description={`${merk} ${rawModel.name}: ${en.intro} SEER up to ${num(bestEff?.seer)}, label up to ${bestLabels?.koelen}. Installed from ${site.priceFromEn}.`}
>
  <PageHero title={`${merk} ${rawModel.name}`} description={en.intro} image={pageHeroPhoto} />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={`${basis}/`} class="hover:text-brand-700">{merk}</a>
        <span class="px-1">/</span>
        <span class="text-slate-700">{rawModel.name}</span>
      </nav>

      <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-stretch">
        <div class="panel relative min-h-[22rem] overflow-hidden bg-gradient-to-br from-brand-50 via-white to-white lg:col-span-7">
          <img
            src={rawModel.photo}
            alt={`${merk} ${rawModel.name} air conditioner with indoor unit, outdoor unit and remote control`}
            width="650"
            height="650"
            loading="eager"
            class="absolute inset-0 h-full w-full object-contain p-6"
          />
        </div>
        <div class="panel flex flex-col p-6 sm:p-8 lg:col-span-5">
          <p class="text-sm font-semibold uppercase tracking-wider text-gold-600">
            {rawModel.serie} &middot; {en.tier}
          </p>
          <h2 class="section-heading mt-2">Features</h2>
          <dl class="mt-6 space-y-4">
            <div class="flex items-start gap-3">
              <img src="/spec-icons/rendement.png" alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
              <div>
                <dt class="text-sm text-slate-500">SEER (up to) / SCOP</dt>
                <dd class="font-semibold text-brand-900">{num(bestEff?.seer)} / {num(bestEff?.scop)}</dd>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <img src="/spec-icons/koelen.png" alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
              <div>
                <dt class="text-sm text-slate-500">Energy label cooling / heating</dt>
                <dd class="flex items-center gap-2 font-semibold text-brand-900">
                  <span class={`rounded px-2 py-0.5 text-xs font-bold text-white ${labelKleur(bestLabels?.koelen)}`}>
                    {bestLabels?.koelen}
                  </span>
                  <span class={`rounded px-2 py-0.5 text-xs font-bold text-white ${labelKleur(bestLabels?.verwarmen)}`}>
                    {bestLabels?.verwarmen}
                  </span>
                </dd>
              </div>
            </div>
            {
              specs.map((s) => (
                <div class="flex items-start gap-3">
                  <img src={`/spec-icons/${s.icon}.png`} alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
                  <div>
                    <dt class="text-sm text-slate-500">{s.label}</dt>
                    <dd class="font-semibold text-brand-900">{s.value}</dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="mt-8 rounded-2xl bg-brand-950 px-6 py-6 text-white shadow-card sm:px-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-gold-400">Standard on every MHI</p>
        <div class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-3 lg:grid-cols-6">
          {
            sharedEn['mitsubishi-heavy-industries'].map((item) => (
              <span class="flex items-start gap-2 text-sm text-brand-100">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-gold-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                {item}
              </span>
            ))
          }
        </div>
      </div>

      <h2 class="section-heading mt-16">Available capacities</h2>
      <p class="mt-3 text-slate-600">
        Choose the capacity that suits your room and click through for the details. The guidance is a rule of thumb at
        roughly 2.6 m ceiling height and average insulation. With a lot of glass, high ceilings or a corner or top-floor
        home we advise a larger capacity. We are happy to make an exact calculation for your home.
      </p>
      <div
        class={`mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 ${
          modelSizes.length >= 5 ? 'lg:grid-cols-5' : 'lg:grid-cols-4'
        }`}
      >
        {
          modelSizes.map((size) => (
            <a href={`${basis}/${rawModel.slug}/${size.slug}/`} class="group card-link flex flex-col p-6">
              <p class="text-2xl font-bold text-brand-900">{num(size.kw)}</p>
              <p class="mt-2 min-h-[2.5rem] text-sm text-slate-600">{sizeRoomEn[size.slug] ?? size.room}</p>
              <p class="mt-1 text-sm text-slate-500">{num(size.volume)} &middot; {num(size.area)}</p>
              <span class="mt-auto pt-4 text-sm font-semibold text-brand-700 transition group-hover:text-brand-900">
                View details
                <span aria-hidden="true" class="transition group-hover:translate-x-0.5">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>

      <div class="mt-10">
        <a href="/en/contact/" class="btn-primary inline-flex">Request a quote</a>
      </div>

      <h2 class="section-heading mt-16">Other MHI series</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          others.map((m) => (
            <a href={`${basis}/${m.slug}/`} class="group card-link flex flex-col p-6">
              <p class="text-xs font-semibold uppercase tracking-wider text-gold-600">
                {m.serie} &middot; {mhiTextEn[m.slug].tier}
              </p>
              <h3 class="mt-1 text-lg font-bold text-brand-900">{merk} {m.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{mhiTextEn[m.slug].intro}</p>
              <span class="mt-auto pt-4 text-sm font-semibold text-brand-700 transition group-hover:text-brand-900">
                View series
                <span aria-hidden="true" class="transition group-hover:translate-x-0.5">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    lang="en"
    title={`Have the ${merk} ${rawModel.name} installed`}
    description={`Best Aircotechniek handles advice, supply and expert installation from ${site.priceFromEn}. Request a free quote with no obligation.`}
  />
  <ProductSchema
    lang="en"
    name={`${merk} ${rawModel.name} air conditioner`}
    brand={merk}
    description={`${merk} ${rawModel.name}: ${en.intro} Available in ${modelSizes.length} capacities, SEER up to ${num(bestEff?.seer)} and SCOP up to ${num(bestEff?.scop)}, energy label up to ${bestLabels?.koelen} for cooling and ${bestLabels?.verwarmen} for heating.`}
    image={rawModel.photo}
    specs={schemaSpecs}
  />
</BaseLayout>
