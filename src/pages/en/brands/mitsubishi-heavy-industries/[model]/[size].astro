---
/**
 * Engelse spiegel van de MHI-vermogenspagina. Cijfers uit mhi-products.ts,
 * teksten uit products-en.ts, decimale komma's via num().
 */
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../../components/CTASection.astro';
import { mhiModels, mhiSizesFor, mhiCapacity } from '../../../../../data/mhi-products';
import { coolingLabel, heatingLabel } from '../../../../../data/energy-labels';
import { site } from '../../../../../data/site';
import { mhiTextEn, sizeRoomEn, num } from '../../../../../i18n/products-en';
import ProductSchema from '../../../../../components/ProductSchema.astro';
import { acSpecs } from '../../../../../lib/schema-specs';

export function getStaticPaths() {
  return mhiModels.flatMap((model) =>
    mhiSizesFor(model.slug).map((size) => ({
      params: { model: model.slug, size: size.slug },
      props: { model, size },
    })),
  );
}

const rawModel = Astro.props.model;
const size = Astro.props.size;
const en = mhiTextEn[rawModel.slug];
const merk = 'Mitsubishi Heavy Industries';
const basis = '/en/brands/mitsubishi-heavy-industries';
const roomEn = sizeRoomEn[size.slug] ?? size.room;
const cap = mhiCapacity(rawModel.slug, size.slug)!;
const labelKoelen = coolingLabel(cap.seer);
const labelVerwarmen = heatingLabel(cap.scop);
const labelKleur = (label: string) =>
  label === 'A+++' ? 'bg-[#00a651]' : label === 'A++' ? 'bg-[#2f9e44]' : 'bg-[#94b820]';
const luchtreiniging = en.specs[rawModel.specs.findIndex((s) => s.icon === 'luchtzuivering')].value;

const sizesData = mhiSizesFor(rawModel.slug).map((s) => {
  const c = mhiCapacity(rawModel.slug, s.slug)!;
  return {
    slug: s.slug,
    kw: num(s.kw),
    volume: num(s.volume),
    area: num(s.area),
    room: sizeRoomEn[s.slug] ?? s.room,
    code: c.code,
    outdoor: c.outdoor,
    koel: `${num(c.koel)} kW`,
    verw: `${num(c.verw)} kW`,
    koelBereik: `${num(c.koelMin)} to ${num(c.koelMax)} kW`,
    verwBereik: `${num(c.verwMin)} to ${num(c.verwMax)} kW`,
    seer: num(c.seer),
    scop: num(c.scop),
    db: `${c.db} dB(A)`,
    labelKoelen: coolingLabel(c.seer),
    labelVerwarmen: heatingLabel(c.scop),
  };
});

const rows = [
  { icon: 'koelen', label: 'Cooling capacity (nominal)', value: `${num(cap.koel)} kW`, badge: labelKoelen, badgeId: 'val-label-koelen', id: 'val-koel' },
  { icon: 'verwarmen', label: 'Heating capacity (nominal)', value: `${num(cap.verw)} kW`, badge: labelVerwarmen, badgeId: 'val-label-verwarmen', id: 'val-verw' },
  { icon: 'ruimte', label: 'Suitable for', value: `Rooms up to ${num(size.volume)}`, id: 'val-volume' },
  { icon: 'swing', label: 'Floor area (rule of thumb)', value: num(size.area), id: 'val-area' },
  { icon: 'rendement', label: 'SEER / SCOP', value: `${num(cap.seer)} / ${num(cap.scop)}`, id: 'val-rendement' },
  { icon: 'luchtzuivering', label: 'Air purification', value: luchtreiniging },
  { icon: 'wifi', label: 'Controls', value: 'Remote control and Smart M-Air app' },
];

const extra: { label: string; value: string; id?: string }[] = [
  { label: 'Indoor unit model code', value: cap.code, id: 'val-code' },
  { label: 'Outdoor unit model code', value: cap.outdoor, id: 'val-outdoor' },
  { label: 'Cooling capacity (range)', value: `${num(cap.koelMin)} to ${num(cap.koelMax)} kW`, id: 'val-koel-bereik' },
  { label: 'Heating capacity (range)', value: `${num(cap.verwMin)} to ${num(cap.verwMax)} kW`, id: 'val-verw-bereik' },
  { label: 'Sound pressure (quietest setting)', value: `${cap.db} dB(A)`, id: 'val-db' },
  { label: 'Typical room', value: roomEn, id: 'val-room' },
  { label: 'Finish', value: en.uitvoeringen ?? rawModel.uitvoeringen },
  { label: 'Refrigerant', value: 'R32' },
  { label: 'Warranty', value: '5 year parts warranty' },
];

const btnBase = 'size-btn rounded-xl px-5 py-2.5 font-semibold transition ';
const btnActive = 'border-2 border-brand-700 bg-white text-brand-900 shadow-sm';
const btnInactive = 'border border-slate-300 bg-white text-slate-700 hover:border-brand-500 hover:text-brand-900';
const schemaSpecs = acSpecs({
  lang: 'en',
  koel: cap.koel, verw: cap.verw, koelMax: cap.koelMax, verwMax: cap.verwMax,
  seer: cap.seer, scop: cap.scop, labelKoelen, labelVerwarmen,
  refrigerant: 'R32', warranty: '5 year parts warranty',
});
---

<BaseLayout
  lang="en"
  title={`${merk} ${rawModel.name} ${num(size.kw)} | Best Aircotechniek`}
  description={`${merk} ${rawModel.name} ${num(size.kw)} (${cap.code}): ${num(cap.koel)} kW cooling and ${num(cap.verw)} kW heating, energy label ${labelKoelen}. Installed from ${site.priceFromEn}.`}
>
  <section class="pt-8 pb-16 sm:pt-10 sm:pb-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={`${basis}/`} class="hover:text-brand-700">{merk}</a>
        <span class="px-1">/</span>
        <a href={`${basis}/${rawModel.slug}/`} class="hover:text-brand-700">{rawModel.name}</a>
        <span class="px-1">/</span>
        <span id="crumb-size" class="text-slate-700">{num(size.kw)}</span>
      </nav>

      <div class="mt-4">
        <p class="text-sm font-semibold uppercase tracking-wider text-gold-600">
          {rawModel.serie} &middot; {en.tier}
        </p>
        <h1 id="page-title" class="mt-1 text-3xl font-extrabold tracking-tight text-brand-900 sm:text-4xl">
          {merk} {rawModel.name} {num(size.kw)}
        </h1>
        <p id="page-sub" class="mt-2 text-slate-600">
          Suitable for {roomEn.toLowerCase()} ({num(size.volume)}).
        </p>
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
        <span class="text-sm font-semibold text-slate-700">Choose your capacity</span>
        <div class="flex flex-wrap gap-3">
          {
            mhiSizesFor(rawModel.slug).map((s) => (
              <a
                href={`${basis}/${rawModel.slug}/${s.slug}/`}
                data-size={s.slug}
                class={btnBase + (s.slug === size.slug ? btnActive : btnInactive)}
              >
                {num(s.kw)}
              </a>
            ))
          }
        </div>
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-stretch">
        <div class="panel flex min-h-[22rem] flex-col items-center justify-center gap-5 bg-gradient-to-br from-brand-50 via-white to-white p-8 lg:col-span-7">
          <img
            src={rawModel.photo}
            alt={`${merk} ${rawModel.name} air conditioner with indoor unit, outdoor unit and remote control`}
            width="650"
            height="650"
            loading="eager"
            class="w-full max-w-[26rem] object-contain"
          />
          <div class="text-center">
            <p id="panel-title" class="text-3xl font-extrabold text-brand-900">{rawModel.name} {num(size.kw)}</p>
            <p class="mt-4 text-sm text-slate-500">
              Model code: <span id="panel-code">{cap.code}</span>
            </p>
          </div>
        </div>

        <div class="panel flex flex-col p-6 sm:p-8 lg:col-span-5">
          <h2 class="section-heading">Specifications</h2>
          <dl class="mt-6 space-y-4">
            {
              rows.map((r) => (
                <div class="flex items-start gap-3">
                  <img src={`/spec-icons/${r.icon}.png`} alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
                  <div>
                    <dt class="text-sm text-slate-500">{r.label}</dt>
                    <dd class="flex items-center gap-2 font-semibold text-brand-900">
                      <span id={r.id}>{r.value}</span>
                      {r.badge && (
                        <span id={r.badgeId} class={`rounded px-2 py-0.5 text-xs font-bold text-white ${labelKleur(r.badge)}`}>
                          {r.badge}
                        </span>
                      )}
                    </dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="panel mt-8 p-6 sm:p-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="min-w-0 flex-1">
            <h3 class="text-lg font-bold text-brand-900">More details</h3>
            <ul class="mt-4 space-y-2 text-sm">
              {
                extra.map((e) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500" />
                    <span class="text-slate-600">
                      <span class="font-semibold text-brand-900">{e.label}:</span>{' '}
                      <span id={e.id}>{e.value}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="shrink-0 lg:pl-8">
            <a href="/en/contact/" class="btn-primary inline-flex w-full justify-center sm:w-auto">Request a quote</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    lang="en"
    title={`Have the ${merk} ${rawModel.name} installed`}
    description={`Best Aircotechniek handles advice, supply and expert installation from ${site.priceFromEn}. Request a free quote with no obligation.`}
  />

  <script define:vars={{ sizesData, modelSlug: rawModel.slug, modelName: rawModel.name, merk, basis, btnBase, btnActive, btnInactive }}>
    const links = Array.from(document.querySelectorAll('a[data-size]'));
    function applySize(slug) {
      const d = sizesData.find((s) => s.slug === slug);
      if (!d) return;
      const setText = (id, text) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };
      setText('val-koel', d.koel);
      setText('val-verw', d.verw);
      setText('val-volume', 'Rooms up to ' + d.volume);
      setText('val-area', d.area);
      setText('val-rendement', d.seer + ' / ' + d.scop);
      setText('val-code', d.code);
      setText('val-outdoor', d.outdoor);
      setText('val-koel-bereik', d.koelBereik);
      setText('val-verw-bereik', d.verwBereik);
      setText('val-db', d.db);
      setText('val-room', d.room);
      const paint = (id, v) => {
        const el = document.getElementById(id);
        if (!el || !v) return;
        el.textContent = v;
        el.className =
          'rounded px-2 py-0.5 text-xs font-bold text-white ' +
          (v === 'A+++' ? 'bg-[#00a651]' : v === 'A++' ? 'bg-[#2f9e44]' : 'bg-[#94b820]');
      };
      paint('val-label-koelen', d.labelKoelen);
      paint('val-label-verwarmen', d.labelVerwarmen);
      setText('panel-title', modelName + ' ' + d.kw);
      setText('panel-code', d.code);
      setText('crumb-size', d.kw);
      setText('page-title', merk + ' ' + modelName + ' ' + d.kw);
      setText('page-sub', 'Suitable for ' + d.room.toLowerCase() + ' (' + d.volume + ').');
      links.forEach((a) => {
        a.className = btnBase + (a.dataset.size === slug ? btnActive : btnInactive);
      });
      document.title = merk + ' ' + modelName + ' ' + d.kw + ' | Best Aircotechniek';
      history.replaceState(null, '', basis + '/' + modelSlug + '/' + slug + '/');
    }
    links.forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        applySize(a.dataset.size);
      }),
    );
  </script>
  <ProductSchema
    lang="en"
    name={`${merk} ${rawModel.name} ${num(size.kw)} air conditioner`}
    brand={merk}
    sku={cap.code}
    description={`${merk} ${rawModel.name} ${num(size.kw)} (${cap.code} with outdoor unit ${cap.outdoor}): ${num(cap.koel)} kW cooling capacity and ${num(cap.verw)} kW heating capacity, SEER ${num(cap.seer)} and SCOP ${num(cap.scop)}, energy label ${labelKoelen} for cooling and ${labelVerwarmen} for heating. Installation included by Best Aircotechniek.`}
    image={rawModel.photo}
    specs={schemaSpecs}
  />
</BaseLayout>
