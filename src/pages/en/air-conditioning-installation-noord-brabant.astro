---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import pageHeroPhoto from '../../assets/photos/page-hero-woning.jpg';
import { locationsEn } from '../../data/locations-en';
import { site } from '../../data/site';
---

<BaseLayout
  lang="en"
  title={`Air conditioning installer Noord-Brabant from ${site.priceFrom} | Best Aircotechniek`}
  description={`Looking for an air conditioning installer in Noord-Brabant? Best Aircotechniek installs in Best, Eindhoven, Tilburg, Den Bosch and beyond, from ${site.priceFrom}. We speak English.`}
>
  <PageHero
    title="Air conditioning installer in Noord-Brabant"
    description="Expert air conditioning installation across Noord-Brabant. Choose your town to see what we can do for you."
    image={pageHeroPhoto}
  />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="gold-accent-line"></div>
        <h2 class="section-heading mt-6">Your air conditioning specialist in the region</h2>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">
          Best Aircotechniek installs air conditioning for homes and businesses throughout Noord-Brabant. From our
          base in Best we are quickly on site across the region. You get personal advice, an expert installation
          and fair prices, with a complete installation starting at {site.priceFrom} including VAT and installation.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">
          We work with reliable brands such as Daikin, LG and AUX, with 2 to 5 years manufacturer warranty on the
          unit depending on the brand, and 2 years on the installation. Choose your town below, or
          <a href="/en/contact" class="font-semibold text-brand-700 underline">get in touch directly</a>.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">
          Many of our customers in this region are internationals. Everything from the first message to the
          handover can be handled in English.
        </p>
      </div>

      <h2 class="section-heading mt-16">Choose your town</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          locationsEn.map((loc) => (
            <li>
              <a
                href={`/en/air-conditioning-installation-${loc.slug}`}
                class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-gold-400 hover:shadow-md"
              >
                <span class="flex items-center gap-3">
                  <span
                    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-800 text-white"
                    aria-hidden="true"
                  >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                    </svg>
                  </span>
                  <span class="text-lg font-bold text-brand-900">Air conditioning {loc.city}</span>
                </span>
                <span class="mt-3 text-sm leading-relaxed text-slate-600">{loc.heroDescription}</span>
                <span class="mt-4 text-sm font-semibold text-brand-700 group-hover:text-brand-900">
                  View {loc.city} &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-10 text-slate-600">
        Is your town not listed? We work throughout Noord-Brabant and the surrounding area.
        <a href="/en/contact" class="font-semibold text-brand-700 underline">Get in touch</a> and we will see what
        we can do for you.
      </p>
    </div>
  </section>

  <CTASection
    lang="en"
    title="Ready for the best climate?"
    description="Request free advice or a quote. We respond within 24 hours."
  />
</BaseLayout>
