---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import PageHero from '../../components/PageHero.astro';
import pageHeroPhoto from '../../assets/photos/page-hero-woning.jpg';
import { site } from '../../data/site';
import { locations } from '../../data/locations';
---

<BaseLayout
  lang="en"
  title="About us: air conditioning specialist in Noord-Brabant | Best Aircotechniek"
  description="Your personal air conditioning installer in Best and the surrounding area. Honest advice, tidy work and aftercare. Get to know Best Aircotechniek. We speak English."
>
  <PageHero
    title="About us"
    description="Best Aircotechniek stands for quality, reliability and a cool result you will enjoy for years."
    image={pageHeroPhoto}
  />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="section-heading">Who we are</h2>
        <p class="mt-6 text-lg leading-relaxed text-slate-600">
          Best Aircotechniek is a young and ambitious company specialising in installing air conditioning
          systems for private homes and businesses. We believe everyone is entitled to a comfortable indoor
          climate, in summer and in winter.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">
          With an eye for detail and respect for your home or premises, we deliver a tidy installation and
          clear communication from start to finish. We work for many internationals in the Eindhoven region,
          so everything can be handled in English.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading text-center">Why customers choose us</h2>
      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        <div class="rounded-2xl bg-white p-8 shadow-sm">
          <h3 class="text-lg font-semibold text-slate-900">Personal contact</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            You speak directly with us. No call centres and no long waiting times. Short lines and clear
            agreements.
          </p>
        </div>
        <div class="rounded-2xl bg-white p-8 shadow-sm">
          <h3 class="text-lg font-semibold text-slate-900">Tidy work</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            We leave your home or premises neat. Professional finishing and careful installation come first.
          </p>
        </div>
        <div class="rounded-2xl bg-white p-8 shadow-sm">
          <h3 class="text-lg font-semibold text-slate-900">Honest advice</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            We advise what genuinely suits your situation. No unnecessary upselling, just the best solution for
            your budget.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-brand-200 bg-brand-50 p-8 sm:p-12">
        <div class="max-w-3xl">
          <div class="gold-accent-line"></div>
          <h2 class="section-heading mt-6">Service area</h2>
          <p class="section-subheading">
            We install air conditioning throughout {site.region}. Select your town for more information, or view
            our
            <a href="/en/air-conditioning-installation-noord-brabant" class="font-semibold text-brand-700 underline">full service area</a>.
          </p>
        </div>

        <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {
            locations.map((loc) => (
              <li>
                <a
                  href={`/en/air-conditioning-installation-${loc.slug}`}
                  class="flex items-center gap-3 rounded-xl border border-brand-100 bg-white px-4 py-3 shadow-sm transition hover:border-gold-400 hover:shadow-md"
                >
                  <span
                    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-800 text-white"
                    aria-hidden="true"
                  >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                    </svg>
                  </span>
                  <span class="font-semibold text-brand-900">{loc.city}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CTASection lang="en" />
</BaseLayout>
