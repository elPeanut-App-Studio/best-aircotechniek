---
/**
 * Modelpagina voor een MHI-serie (ZT, ZSX of ZS).
 *
 * Opgezet naar het model van de LG-modelpagina, met twee verschillen: er is
 * geen brochure om te downloaden (MHI's eigen beeldmateriaal mag niet
 * gepubliceerd worden en een actuele Nederlandse brochure met de ZT bestaat
 * niet publiek), en het icoon per kenmerk komt uit de data in plaats van uit
 * een positionele array op deze pagina.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTASection from '../../../components/CTASection.astro';
import {
  mhiModels,
  mhiSizesFor,
  mhiShared,
  mhiBestLabels,
  mhiBestEfficiency,
} from '../../../data/mhi-products';
import { site } from '../../../data/site';
import pageHeroPhoto from '../../../assets/photos/page-hero-woning.jpg';
import ProductSchema from '../../../components/ProductSchema.astro';
import { acSpecs } from '../../../lib/schema-specs';

export function getStaticPaths() {
  return mhiModels.map((model) => ({ params: { model: model.slug }, props: { model } }));
}

const { model } = Astro.props;
const merk = 'Mitsubishi Heavy Industries';
const basis = '/merken/mitsubishi-heavy-industries';

const others = mhiModels.filter((m) => m.slug !== model.slug);
const modelSizes = mhiSizesFor(model.slug);
const bestLabels = mhiBestLabels(model.slug);
const bestEff = mhiBestEfficiency(model.slug);
const labelKleur = (label?: string) =>
  label === 'A+++' ? 'bg-[#00a651]' : label === 'A++' ? 'bg-[#2f9e44]' : 'bg-[#94b820]';
const schemaSpecs = acSpecs({
  seer: bestEff?.seer, scop: bestEff?.scop,
  labelKoelen: bestLabels?.koelen, labelVerwarmen: bestLabels?.verwarmen,
  refrigerant: 'R32', warranty: '5 jaar garantie op onderdelen',
});
---

<BaseLayout
  title={`${merk} ${model.name} | Best Aircotechniek`}
  description={`${merk} ${model.name}: SEER tot ${bestEff?.seer} en energielabel tot ${bestLabels?.koelen}, in ${modelSizes.length} vermogens. Laten installeren vanaf ${site.priceFrom}.`}
>
  <PageHero title={`${merk} ${model.name}`} description={model.intro} image={pageHeroPhoto} />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-500" aria-label="Kruimelpad">
        <a href={`${basis}/`} class="hover:text-brand-700">{merk}</a>
        <span class="px-1">/</span>
        <span class="text-slate-700">{model.name}</span>
      </nav>

      <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-stretch">
        <div class="panel relative min-h-[22rem] overflow-hidden bg-gradient-to-br from-brand-50 via-white to-white lg:col-span-7">
          <img
            src={model.photo}
            alt={`${merk} ${model.name} airconditioner met binnenunit, buitenunit en afstandsbediening`}
            width="650"
            height="650"
            loading="eager"
            class="absolute inset-0 h-full w-full object-contain p-6"
          />
        </div>
        <div class="panel flex flex-col p-6 sm:p-8 lg:col-span-5">
          <p class="text-sm font-semibold uppercase tracking-wider text-gold-600">
            {model.serie} &middot; {model.tier}
          </p>
          <h2 class="section-heading mt-2">Kenmerken</h2>
          <dl class="mt-6 space-y-4">
            <div class="flex items-start gap-3">
              <img src="/spec-icons/rendement.png" alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
              <div>
                <dt class="text-sm text-slate-500">SEER (tot) / SCOP</dt>
                <dd class="font-semibold text-brand-900">{bestEff?.seer} / {bestEff?.scop}</dd>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <img src="/spec-icons/koelen.png" alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
              <div>
                <dt class="text-sm text-slate-500">Energielabel koelen / verwarmen</dt>
                <dd class="flex items-center gap-2 font-semibold text-brand-900">
                  <span class={`rounded px-2 py-0.5 text-xs font-bold text-white ${labelKleur(bestLabels?.koelen)}`}>
                    {bestLabels?.koelen}
                  </span>
                  <span class={`rounded px-2 py-0.5 text-xs font-bold text-white ${labelKleur(bestLabels?.verwarmen)}`}>
                    {bestLabels?.verwarmen}
                  </span>
                </dd>
              </div>
            </div>
            {
              model.specs.map((s) => (
                <div class="flex items-start gap-3">
                  <img src={`/spec-icons/${s.icon}.png`} alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
                  <div>
                    <dt class="text-sm text-slate-500">{s.label}</dt>
                    <dd class="font-semibold text-brand-900">{s.value}</dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="mt-8 rounded-2xl bg-brand-950 px-6 py-6 text-white shadow-card sm:px-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-gold-400">Standaard bij elke MHI</p>
        <div class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-3 lg:grid-cols-6">
          {
            mhiShared.map((item) => (
              <span class="flex items-start gap-2 text-sm text-brand-100">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-gold-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                {item}
              </span>
            ))
          }
        </div>
      </div>

      <h2 class="section-heading mt-16">Beschikbare vermogens</h2>
      <p class="mt-3 text-slate-600">
        Kies het vermogen dat past bij uw ruimte. Klik door voor de details. De richtlijnen zijn een vuistregel bij
        ongeveer 2,6 m plafondhoogte en gemiddelde isolatie. Bij veel glas, hoge plafonds of een hoek- of dakwoning
        adviseren wij een ruimere capaciteit. Wij maken graag een exacte berekening voor uw woning.
      </p>
      <div
        class={`mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 ${
          modelSizes.length >= 5 ? 'lg:grid-cols-5' : 'lg:grid-cols-4'
        }`}
      >
        {
          modelSizes.map((size) => (
            <a href={`${basis}/${model.slug}/${size.slug}/`} class="group card-link flex flex-col p-6">
              <p class="text-2xl font-bold text-brand-900">{size.kw}</p>
              <p class="mt-2 min-h-[2.5rem] text-sm text-slate-600">{size.room}</p>
              <p class="mt-1 text-sm text-slate-500">{size.volume} &middot; {size.area}</p>
              <span class="mt-auto pt-4 text-sm font-semibold text-brand-700 transition group-hover:text-brand-900">
                Bekijk details
                <span aria-hidden="true" class="transition group-hover:translate-x-0.5">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>

      <div class="mt-10">
        <a href="/contact/" class="btn-primary inline-flex">Vraag een offerte aan</a>
      </div>

      <h2 class="section-heading mt-16">Andere MHI-modellen</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          others.map((m) => (
            <a href={`${basis}/${m.slug}/`} class="group card-link flex flex-col p-6">
              <p class="text-xs font-semibold uppercase tracking-wider text-gold-600">{m.serie} &middot; {m.tier}</p>
              <h3 class="mt-1 text-lg font-bold text-brand-900">{merk} {m.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{m.intro}</p>
              <span class="mt-auto pt-4 text-sm font-semibold text-brand-700 transition group-hover:text-brand-900">
                Bekijk model
                <span aria-hidden="true" class="transition group-hover:translate-x-0.5">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    title={`${merk} ${model.name} laten installeren?`}
    description={`Best Aircotechniek verzorgt advies, levering en een vakkundige montage vanaf ${site.priceFrom}. Vraag een vrijblijvende offerte aan.`}
  />
  <ProductSchema
    name={`${merk} ${model.name} airconditioner`}
    brand={merk}
    description={`${merk} ${model.name}: ${model.intro} Leverbaar in ${modelSizes.length} vermogens, SEER tot ${bestEff?.seer} en SCOP tot ${bestEff?.scop}, energielabel tot ${bestLabels?.koelen} koelen en ${bestLabels?.verwarmen} verwarmen.`}
    image={model.photo}
    specs={schemaSpecs}
  />
</BaseLayout>
