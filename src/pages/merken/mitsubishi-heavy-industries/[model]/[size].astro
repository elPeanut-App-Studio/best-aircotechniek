---
/**
 * Vermogenspagina voor één MHI-uitvoering.
 *
 * Zelfde opzet als de LG-vermogenspagina, inclusief de wisselaar die zonder
 * herladen de cijfers verwisselt en de URL bijwerkt. MHI publiceert per type
 * ook het modulatiebereik en de geluidsdruk, dus die staan hier extra bij.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../components/CTASection.astro';
import { mhiModels, mhiSizesFor, mhiCapacity } from '../../../../data/mhi-products';
import { coolingLabel, heatingLabel } from '../../../../data/energy-labels';
import { site } from '../../../../data/site';
import ProductSchema from '../../../../components/ProductSchema.astro';
import { acSpecs } from '../../../../lib/schema-specs';

export function getStaticPaths() {
  return mhiModels.flatMap((model) =>
    mhiSizesFor(model.slug).map((size) => ({
      params: { model: model.slug, size: size.slug },
      props: { model, size },
    })),
  );
}

const { model, size } = Astro.props;
const merk = 'Mitsubishi Heavy Industries';
const basis = '/merken/mitsubishi-heavy-industries';
const cap = mhiCapacity(model.slug, size.slug)!;
const labelKoelen = coolingLabel(cap.seer);
const labelVerwarmen = heatingLabel(cap.scop);
const labelKleur = (label: string) =>
  label === 'A+++' ? 'bg-[#00a651]' : label === 'A++' ? 'bg-[#2f9e44]' : 'bg-[#94b820]';

// Gegevens voor de wisselaar, zodat de scrollpositie behouden blijft
const sizesData = mhiSizesFor(model.slug).map((s) => {
  const c = mhiCapacity(model.slug, s.slug)!;
  return {
    slug: s.slug,
    kw: s.kw,
    volume: s.volume,
    area: s.area,
    room: s.room,
    code: c.code,
    outdoor: c.outdoor,
    koel: `${c.koel} kW`,
    verw: `${c.verw} kW`,
    koelBereik: `${c.koelMin} tot ${c.koelMax} kW`,
    verwBereik: `${c.verwMin} tot ${c.verwMax} kW`,
    seer: c.seer,
    scop: c.scop,
    db: `${c.db} dB(A)`,
    labelKoelen: coolingLabel(c.seer),
    labelVerwarmen: heatingLabel(c.scop),
  };
});

const rows = [
  { icon: 'koelen', label: 'Koelvermogen (nominaal)', value: `${cap.koel} kW`, badge: labelKoelen, badgeId: 'val-label-koelen', id: 'val-koel' },
  { icon: 'verwarmen', label: 'Verwarmingsvermogen (nominaal)', value: `${cap.verw} kW`, badge: labelVerwarmen, badgeId: 'val-label-verwarmen', id: 'val-verw' },
  { icon: 'ruimte', label: 'Geschikt voor', value: `Ruimtes tot ${size.volume}`, id: 'val-volume' },
  { icon: 'swing', label: 'Vloeroppervlak (vuistregel)', value: size.area, id: 'val-area' },
  { icon: 'rendement', label: 'SEER / SCOP', value: `${cap.seer} / ${cap.scop}`, id: 'val-rendement' },
  { icon: 'luchtzuivering', label: 'Luchtreiniging', value: model.specs.find((s) => s.icon === 'luchtzuivering')!.value },
  { icon: 'wifi', label: 'Bediening', value: 'Afstandsbediening en Smart M-Air-app' },
];

const extra: { label: string; value: string; id?: string }[] = [
  { label: 'Typeaanduiding binnendeel', value: cap.code, id: 'val-code' },
  { label: 'Typeaanduiding buitendeel', value: cap.outdoor, id: 'val-outdoor' },
  { label: 'Koelvermogen (bereik)', value: `${cap.koelMin} tot ${cap.koelMax} kW`, id: 'val-koel-bereik' },
  { label: 'Verwarmingsvermogen (bereik)', value: `${cap.verwMin} tot ${cap.verwMax} kW`, id: 'val-verw-bereik' },
  { label: 'Geluidsdruk (stilste stand)', value: `${cap.db} dB(A)`, id: 'val-db' },
  { label: 'Typische ruimte', value: size.room, id: 'val-room' },
  { label: 'Uitvoering', value: model.uitvoeringen },
  { label: 'Koudemiddel', value: 'R32' },
  { label: 'Garantie', value: '5 jaar garantie op onderdelen' },
];

const btnBase = 'size-btn rounded-xl px-5 py-2.5 font-semibold transition ';
const btnActive = 'border-2 border-brand-700 bg-white text-brand-900 shadow-sm';
const btnInactive = 'border border-slate-300 bg-white text-slate-700 hover:border-brand-500 hover:text-brand-900';
const schemaSpecs = acSpecs({
  koel: cap.koel, verw: cap.verw, koelMax: cap.koelMax, verwMax: cap.verwMax,
  seer: cap.seer, scop: cap.scop, labelKoelen, labelVerwarmen,
  refrigerant: 'R32', warranty: '5 jaar garantie op onderdelen',
});
---

<BaseLayout
  title={`${merk} ${model.name} ${size.kw} | Best Aircotechniek`}
  description={`${merk} ${model.name} ${size.kw} (${cap.code}): ${cap.koel} kW koelen en ${cap.verw} kW verwarmen, energielabel ${labelKoelen}. Laten installeren vanaf ${site.priceFrom}.`}
>
  <section class="pt-8 pb-16 sm:pt-10 sm:pb-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-500" aria-label="Kruimelpad">
        <a href={`${basis}/`} class="hover:text-brand-700">{merk}</a>
        <span class="px-1">/</span>
        <a href={`${basis}/${model.slug}/`} class="hover:text-brand-700">{model.name}</a>
        <span class="px-1">/</span>
        <span id="crumb-size" class="text-slate-700">{size.kw}</span>
      </nav>

      <div class="mt-4">
        <p class="text-sm font-semibold uppercase tracking-wider text-gold-600">
          {model.serie} &middot; {model.tier}
        </p>
        <h1 id="page-title" class="mt-1 text-3xl font-extrabold tracking-tight text-brand-900 sm:text-4xl">
          {merk} {model.name} {size.kw}
        </h1>
        <p id="page-sub" class="mt-2 text-slate-600">
          Geschikt voor {size.room.toLowerCase()} ({size.volume}).
        </p>
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
        <span class="text-sm font-semibold text-slate-700">Kies uw vermogen</span>
        <div class="flex flex-wrap gap-3">
          {
            mhiSizesFor(model.slug).map((s) => (
              <a
                href={`${basis}/${model.slug}/${s.slug}/`}
                data-size={s.slug}
                class={btnBase + (s.slug === size.slug ? btnActive : btnInactive)}
              >
                {s.kw}
              </a>
            ))
          }
        </div>
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-stretch">
        <div class="panel flex min-h-[22rem] flex-col items-center justify-center gap-5 bg-gradient-to-br from-brand-50 via-white to-white p-8 lg:col-span-7">
          <img
            src={model.photo}
            alt={`${merk} ${model.name} airconditioner met binnenunit, buitenunit en afstandsbediening`}
            width="650"
            height="650"
            loading="eager"
            class="w-full max-w-[26rem] object-contain"
          />
          <div class="text-center">
            <p id="panel-title" class="text-3xl font-extrabold text-brand-900">{model.name} {size.kw}</p>
            <p class="mt-4 text-sm text-slate-500">
              Typeaanduiding: <span id="panel-code">{cap.code}</span>
            </p>
          </div>
        </div>

        <div class="panel flex flex-col p-6 sm:p-8 lg:col-span-5">
          <h2 class="section-heading">Specificaties</h2>
          <dl class="mt-6 space-y-4">
            {
              rows.map((r) => (
                <div class="flex items-start gap-3">
                  <img src={`/spec-icons/${r.icon}.png`} alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
                  <div>
                    <dt class="text-sm text-slate-500">{r.label}</dt>
                    <dd class="flex items-center gap-2 font-semibold text-brand-900">
                      <span id={r.id}>{r.value}</span>
                      {r.badge && (
                        <span id={r.badgeId} class={`rounded px-2 py-0.5 text-xs font-bold text-white ${labelKleur(r.badge)}`}>
                          {r.badge}
                        </span>
                      )}
                    </dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="panel mt-8 p-6 sm:p-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="min-w-0 flex-1">
            <h3 class="text-lg font-bold text-brand-900">Meer gegevens</h3>
            <ul class="mt-4 space-y-2 text-sm">
              {
                extra.map((e) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500" />
                    <span class="text-slate-600">
                      <span class="font-semibold text-brand-900">{e.label}:</span>{' '}
                      <span id={e.id}>{e.value}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="shrink-0 lg:pl-8">
            <a href="/contact/" class="btn-primary inline-flex w-full justify-center sm:w-auto">Vraag een offerte aan</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title={`${merk} ${model.name} laten installeren`}
    description={`Best Aircotechniek verzorgt advies, levering en een vakkundige montage vanaf ${site.priceFrom}. Vraag een vrijblijvende offerte aan.`}
  />

  <script define:vars={{ sizesData, modelSlug: model.slug, modelName: model.name, merk, basis, btnBase, btnActive, btnInactive }}>
    const links = Array.from(document.querySelectorAll('a[data-size]'));
    function applySize(slug) {
      const d = sizesData.find((s) => s.slug === slug);
      if (!d) return;
      const setText = (id, text) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };
      setText('val-koel', d.koel);
      setText('val-verw', d.verw);
      setText('val-volume', 'Ruimtes tot ' + d.volume);
      setText('val-area', d.area);
      setText('val-rendement', d.seer + ' / ' + d.scop);
      setText('val-code', d.code);
      setText('val-outdoor', d.outdoor);
      setText('val-koel-bereik', d.koelBereik);
      setText('val-verw-bereik', d.verwBereik);
      setText('val-db', d.db);
      setText('val-room', d.room);
      const paint = (id, v) => {
        const el = document.getElementById(id);
        if (!el || !v) return;
        el.textContent = v;
        el.className =
          'rounded px-2 py-0.5 text-xs font-bold text-white ' +
          (v === 'A+++' ? 'bg-[#00a651]' : v === 'A++' ? 'bg-[#2f9e44]' : 'bg-[#94b820]');
      };
      paint('val-label-koelen', d.labelKoelen);
      paint('val-label-verwarmen', d.labelVerwarmen);
      setText('panel-title', modelName + ' ' + d.kw);
      setText('panel-code', d.code);
      setText('crumb-size', d.kw);
      setText('page-title', merk + ' ' + modelName + ' ' + d.kw);
      setText('page-sub', 'Geschikt voor ' + d.room.toLowerCase() + ' (' + d.volume + ').');
      links.forEach((a) => {
        a.className = btnBase + (a.dataset.size === slug ? btnActive : btnInactive);
      });
      document.title = merk + ' ' + modelName + ' ' + d.kw + ' | Best Aircotechniek';
      history.replaceState(null, '', basis + '/' + modelSlug + '/' + slug + '/');
    }
    links.forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        applySize(a.dataset.size);
      }),
    );
  </script>
  <ProductSchema
    name={`${merk} ${model.name} ${size.kw} airconditioner`}
    brand={merk}
    sku={cap.code}
    description={`${merk} ${model.name} ${size.kw} (${cap.code} met buitendeel ${cap.outdoor}): ${cap.koel} kW koelvermogen en ${cap.verw} kW verwarmingsvermogen, SEER ${cap.seer} en SCOP ${cap.scop}, energielabel ${labelKoelen} voor koelen en ${labelVerwarmen} voor verwarmen. Inclusief montage door Best Aircotechniek.`}
    image={model.photo}
    specs={schemaSpecs}
  />
</BaseLayout>
