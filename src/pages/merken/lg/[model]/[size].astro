---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../components/CTASection.astro';
import { lgModels, lgSizesFor, lgCapacity } from '../../../../data/lg-products';
import { coolingLabel, heatingLabel } from '../../../../data/energy-labels';
import { site } from '../../../../data/site';

export function getStaticPaths() {
  return lgModels.flatMap((model) =>
    lgSizesFor(model.slug).map((size) => ({ params: { model: model.slug, size: size.slug }, props: { model, size } })),
  );
}

const { model, size } = Astro.props;
const cap = lgCapacity(model.slug, size.slug)!;
const labelKoelen = coolingLabel(cap.seer);
const labelVerwarmen = heatingLabel(cap.scop);

// Data voor de client-side wisselaar (scrollpositie blijft behouden)
const sizesData = lgSizesFor(model.slug).map((s) => {
  const c = lgCapacity(model.slug, s.slug)!;
  return {
    slug: s.slug,
    kw: s.kw,
    volume: s.volume,
    area: s.area,
    room: s.room,
    typeCode: c.code,
    koel: `${c.koel} kW`,
    verw: `${c.verw} kW`,
    max: `${c.koelMax} kW koelen / ${c.verwMax} kW verwarmen`,
    seer: c.seer,
    scop: c.scop,
    labelKoelen: coolingLabel(c.seer),
    labelVerwarmen: heatingLabel(c.scop),
  };
});

const rows = [
  { icon: 'koelen', label: 'Koelvermogen (nominaal)', value: `${cap.koel} kW`, badge: labelKoelen, badgeId: 'val-label-koelen', id: 'val-koel' },
  { icon: 'verwarmen', label: 'Verwarmingsvermogen (nominaal)', value: `${cap.verw} kW`, badge: labelVerwarmen, badgeId: 'val-label-verwarmen', id: 'val-verw' },
  { icon: 'ruimte', label: 'Geschikt voor', value: `Ruimtes tot ${size.volume}`, id: 'val-volume' },
  { icon: 'swing', label: 'Vloeroppervlak (vuistregel)', value: size.area, id: 'val-area' },
  { icon: 'rendement', label: 'SEER / SCOP', value: `${cap.seer} / ${cap.scop}`, id: 'val-rendement' },
  { icon: 'luchtzuivering', label: 'Luchtreiniging', value: model.specs[0].value },
  { icon: 'wifi', label: 'Bediening', value: 'Afstandsbediening en LG ThinQ-app' },
];

const extra: { label: string; value: string; id?: string }[] = [
  { label: 'Typeaanduiding', value: cap.code, id: 'val-code' },
  { label: 'Maximaal vermogen', value: `${cap.koelMax} kW koelen / ${cap.verwMax} kW verwarmen`, id: 'val-max' },
  { label: 'Typische ruimte', value: size.room, id: 'val-room' },
  { label: 'Slimme functies', value: model.specs[1].value },
  { label: 'Uitvoering', value: model.specs[3].value },
  { label: 'Koudemiddel', value: 'R32' },
  { label: 'Garantie', value: '5 jaar fabrieksgarantie' },
];

const btnBase = 'size-btn rounded-xl px-5 py-2.5 font-semibold transition ';
const btnActive = 'border-2 border-brand-700 bg-white text-brand-900 shadow-sm';
const btnInactive = 'border border-slate-300 bg-white text-slate-700 hover:border-brand-500 hover:text-brand-900';
---

<BaseLayout
  title={`LG ${model.name} ${size.kw} airco | Best Aircotechniek`}
  description={`LG ${model.name} ${size.kw} (${cap.code}): ${cap.koel} kW koelen en ${cap.verw} kW verwarmen, energielabel ${labelKoelen}. Laten installeren vanaf ${site.priceFrom} door Best Aircotechniek.`}
>
  <section class="pt-8 pb-16 sm:pt-10 sm:pb-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-500" aria-label="Kruimelpad">
        <a href="/merken/lg" class="hover:text-brand-700">LG</a>
        <span class="px-1">/</span>
        <a href={`/merken/lg/${model.slug}`} class="hover:text-brand-700">{model.name}</a>
        <span class="px-1">/</span>
        <span id="crumb-size" class="text-slate-700">{size.kw}</span>
      </nav>

      <div class="mt-4">
        <p class="text-sm font-semibold uppercase tracking-wider text-gold-600">{model.tier}</p>
        <h1 id="page-title" class="mt-1 text-3xl font-extrabold tracking-tight text-brand-900 sm:text-4xl">
          LG {model.name} {size.kw}
        </h1>
        <p id="page-sub" class="mt-2 text-slate-600">
          Geschikt voor {size.room.toLowerCase()} ({size.volume}).
        </p>
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
        <span class="text-sm font-semibold text-slate-700">Kies uw vermogen</span>
        <div class="flex flex-wrap gap-3">
          {
            lgSizesFor(model.slug).map((s) => (
              <a
                href={`/merken/lg/${model.slug}/${s.slug}`}
                data-size={s.slug}
                class={btnBase + (s.slug === size.slug ? btnActive : btnInactive)}
              >
                {s.kw}
              </a>
            ))
          }
        </div>
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-stretch">
        <div class="panel flex min-h-[22rem] flex-col items-center justify-center gap-5 bg-gradient-to-br from-brand-50 via-white to-white p-8 lg:col-span-7">
          <img
            src={model.photo}
            alt={`LG ${model.name} airconditioner met binnenunit, buitenunit en afstandsbediening`}
            width="650"
            height="650"
            loading="eager"
            class="w-full max-w-[26rem] object-contain"
          />
          <div class="text-center">
            <p id="panel-title" class="text-3xl font-extrabold text-brand-900">{model.name} {size.kw}</p>
            <p class="mt-4 text-sm text-slate-500">Officiële typeaanduiding: <span id="panel-code">{cap.code}</span></p>
          </div>
        </div>

        <div class="panel flex flex-col p-6 sm:p-8 lg:col-span-5">
          <h2 class="section-heading">Specificaties</h2>
          <dl class="mt-6 space-y-4">
            {
              rows.map((r) => (
                <div class="flex items-start gap-3">
                  <img src={`/spec-icons/${r.icon}.png`} alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
                  <div>
                    <dt class="text-sm text-slate-500">{r.label}</dt>
                    <dd class="flex items-center gap-2 font-semibold text-brand-900">
                      <span id={r.id}>{r.value}</span>
                      {r.badge && (
                        <span
                          id={r.badgeId}
                          class={`rounded px-2 py-0.5 text-xs font-bold text-white ${r.badge === 'A+++' ? 'bg-[#00a651]' : r.badge === 'A++' ? 'bg-[#2f9e44]' : 'bg-[#94b820]'}`}
                        >
                          {r.badge}
                        </span>
                      )}
                    </dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="panel mt-8 p-6 sm:p-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="min-w-0 flex-1">
            <h3 class="text-lg font-bold text-brand-900">Meer kenmerken</h3>
            <ul class="mt-4 space-y-2 text-sm">
              {
                extra.map((e) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500" />
                    <span class="text-slate-600">
                      <span class="font-semibold text-brand-900">{e.label}:</span>{' '}
                      <span id={e.id}>{e.value}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="shrink-0 lg:pl-8">
            <a href="/contact" class="btn-primary inline-flex w-full justify-center sm:w-auto">Vraag een offerte aan</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title={`LG ${model.name} laten installeren?`}
    description={`Best Aircotechniek verzorgt advies, levering en een vakkundige montage vanaf ${site.priceFrom}. Vraag een vrijblijvende offerte aan.`}
  />

  <script
    define:vars={{
      sizesData,
      modelSlug: model.slug,
      modelName: model.name,
      btnBase,
      btnActive,
      btnInactive,
    }}
  >
    const links = Array.from(document.querySelectorAll('a[data-size]'));
    function applySize(slug) {
      const d = sizesData.find((s) => s.slug === slug);
      if (!d) return;
      const setText = (id, text) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };
      setText('val-koel', d.koel);
      setText('val-verw', d.verw);
      setText('val-volume', 'Ruimtes tot ' + d.volume);
      setText('val-area', d.area);
      setText('val-room', d.room);
      setText('val-rendement', d.seer + ' / ' + d.scop);
      setText('val-max', d.max);
      setText('val-code', d.typeCode);
      const paint = (id, v) => {
        const el = document.getElementById(id);
        if (!el || !v) return;
        el.textContent = v;
        el.className =
          'rounded px-2 py-0.5 text-xs font-bold text-white ' +
          (v === 'A+++' ? 'bg-[#00a651]' : v === 'A++' ? 'bg-[#2f9e44]' : 'bg-[#94b820]');
      };
      paint('val-label-koelen', d.labelKoelen);
      paint('val-label-verwarmen', d.labelVerwarmen);
      setText('panel-title', modelName + ' ' + d.kw);
      setText('panel-code', d.typeCode);
      setText('crumb-size', d.kw);
      setText('page-title', 'LG ' + modelName + ' ' + d.kw);
      setText('page-sub', 'Geschikt voor ' + d.room.toLowerCase() + ' (' + d.volume + ').');
      links.forEach((a) => {
        a.className = btnBase + (a.dataset.size === slug ? btnActive : btnInactive);
      });
      document.title = 'LG ' + modelName + ' ' + d.kw + ' airco | Best Aircotechniek';
      history.replaceState(null, '', '/merken/lg/' + modelSlug + '/' + slug);
    }
    links.forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        applySize(a.dataset.size);
      }),
    );
  </script>
</BaseLayout>
