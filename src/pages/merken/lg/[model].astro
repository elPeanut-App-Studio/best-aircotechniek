---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTASection from '../../../components/CTASection.astro';
import { lgModels, lgSizes, lgShared } from '../../../data/lg-products';
import { site } from '../../../data/site';
import pageHeroPhoto from '../../../assets/photos/page-hero-woning.jpg';

export function getStaticPaths() {
  return lgModels.map((model) => ({ params: { model: model.slug }, props: { model } }));
}

const { model } = Astro.props;

// Iconen in dezelfde volgorde als model.specs
const specIcons = ['luchtzuivering', 'zelfreiniging', 'swing', 'design', 'wifi'];
const others = lgModels.filter((m) => m.slug !== model.slug);
---

<BaseLayout
  title={`LG ${model.name} airco laten installeren | Best Aircotechniek`}
  description={`LG ${model.name}: ${model.intro} SEER tot ${model.seer}, energielabel ${model.labelKoelen}. Laten installeren vanaf ${site.priceFrom} door Best Aircotechniek.`}
>
  <PageHero title={`LG ${model.name}`} description={model.intro} image={pageHeroPhoto} />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-500" aria-label="Kruimelpad">
        <a href="/merken/lg" class="hover:text-brand-700">LG</a>
        <span class="px-1">/</span>
        <span class="text-slate-700">{model.name}</span>
      </nav>

      <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-stretch">
        <div class="panel relative min-h-[22rem] overflow-hidden bg-gradient-to-br from-brand-50 via-white to-white lg:col-span-7">
          <img
            src={model.photo}
            alt={`LG ${model.name} airconditioner met binnenunit, buitenunit en afstandsbediening`}
            width="650"
            height="650"
            loading="eager"
            class="absolute inset-0 h-full w-full object-contain p-6"
          />
        </div>
        <div class="panel flex flex-col p-6 sm:p-8 lg:col-span-5">
          <p class="text-sm font-semibold uppercase tracking-wider text-gold-600">{model.tier}</p>
          <h2 class="section-heading mt-2">Kenmerken</h2>
          <dl class="mt-6 space-y-4">
            <div class="flex items-start gap-3">
              <img src="/spec-icons/rendement.png" alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
              <div>
                <dt class="text-sm text-slate-500">SEER (tot) / SCOP</dt>
                <dd class="font-semibold text-brand-900">{model.seer} / {model.scop}</dd>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <img src="/spec-icons/koelen.png" alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
              <div>
                <dt class="text-sm text-slate-500">Energielabel koelen / verwarmen</dt>
                <dd class="flex items-center gap-2 font-semibold text-brand-900">
                  <span
                    class={`rounded px-2 py-0.5 text-xs font-bold text-white ${model.labelKoelen === 'A+++' ? 'bg-[#00a651]' : 'bg-[#2f9e44]'}`}
                  >
                    {model.labelKoelen}
                  </span>
                  <span
                    class={`rounded px-2 py-0.5 text-xs font-bold text-white ${model.labelVerwarmen === 'A+++' ? 'bg-[#00a651]' : model.labelVerwarmen === 'A++' ? 'bg-[#2f9e44]' : 'bg-[#94b820]'}`}
                  >
                    {model.labelVerwarmen}
                  </span>
                </dd>
              </div>
            </div>
            {
              model.specs.map((s, i) => (
                <div class="flex items-start gap-3">
                  <img src={`/spec-icons/${specIcons[i]}.png`} alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
                  <div>
                    <dt class="text-sm text-slate-500">{s.label}</dt>
                    <dd class="font-semibold text-brand-900">{s.value}</dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="mt-8 rounded-2xl bg-brand-950 px-6 py-6 text-white shadow-card sm:px-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-gold-400">Standaard bij elke LG</p>
        <div class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-3 lg:grid-cols-5">
          {
            lgShared.map((item) => (
              <span class="flex items-start gap-2 text-sm text-brand-100">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-gold-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                {item}
              </span>
            ))
          }
        </div>
      </div>

      <h2 class="section-heading mt-16">Welk vermogen past bij uw ruimte?</h2>
      <p class="mt-3 text-slate-600">
        De LG {model.name} is er in meerdere vermogens. Onderstaande tabel is een vuistregel bij ongeveer 2,6 m
        plafondhoogte en gemiddelde isolatie. Bij veel glas, hoge plafonds of een hoek- of dakwoning adviseren wij
        een ruimere capaciteit. Wij maken graag een exacte berekening voor uw woning.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300">
              <th class="py-3 pr-4 text-sm font-semibold text-brand-900">Vermogen</th>
              <th class="py-3 pr-4 text-sm font-semibold text-brand-900">Geschikt tot</th>
              <th class="py-3 pr-4 text-sm font-semibold text-brand-900">Vloeroppervlak</th>
              <th class="py-3 text-sm font-semibold text-brand-900">Typische ruimte</th>
            </tr>
          </thead>
          <tbody>
            {
              lgSizes.map((s) => (
                <tr class="border-b border-slate-200">
                  <td class="py-3 pr-4 font-bold text-brand-900">{s.kw}</td>
                  <td class="py-3 pr-4 text-slate-600">{s.volume}</td>
                  <td class="py-3 pr-4 text-slate-600">{s.area}</td>
                  <td class="py-3 text-slate-600">{s.room}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/contact" class="btn-primary inline-flex">Vraag een offerte aan</a>
        <a href="/lg-airco-brochure.pdf" download class="btn-secondary inline-flex items-center gap-2">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          Download de LG-brochure (pdf)
        </a>
      </div>

      <h2 class="section-heading mt-16">Andere LG-modellen</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        {
          others.map((m) => (
            <a href={`/merken/lg/${m.slug}`} class="group card-link flex flex-col p-6">
              <p class="text-xs font-semibold uppercase tracking-wider text-gold-600">{m.tier}</p>
              <h3 class="mt-1 text-lg font-bold text-brand-900">LG {m.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{m.intro}</p>
              <span class="mt-auto pt-4 text-sm font-semibold text-brand-700 transition group-hover:text-brand-900">
                Bekijk model
                <span aria-hidden="true" class="transition group-hover:translate-x-0.5">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    title={`LG ${model.name} laten installeren?`}
    description={`Best Aircotechniek verzorgt advies, levering en een vakkundige montage vanaf ${site.priceFrom}. Vraag een vrijblijvende offerte aan.`}
  />
</BaseLayout>
