---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../components/CTASection.astro';
import { daikinModels, daikinEfficiency, coolingLabel, heatingLabel } from '../../../../data/daikin-products';
import { site } from '../../../../data/site';
import ProductSchema from '../../../../components/ProductSchema.astro';
import { acSpecs } from '../../../../lib/schema-specs';

export function getStaticPaths() {
  return daikinModels.flatMap((model) =>
    model.sizes.map((size) => ({ params: { model: model.slug, size: size.slug }, props: { model, size } })),
  );
}

const { model, size } = Astro.props;
const eff = daikinEfficiency[model.slug]?.[size.slug];
const labelKoelen = eff ? coolingLabel(eff.seer) : null;
const labelVerwarmen = eff ? heatingLabel(eff.scop) : null;

// Data voor de client-side wisselaar (scrollpositie blijft behouden)
const sizesData = model.sizes.map((s) => ({
  slug: s.slug,
  kw: s.kw,
  koel: s.koel ?? 'Op aanvraag',
  verw: s.verw ?? 'Op aanvraag',
  volume: s.volume,
  area: s.area,
  room: s.room,
  seer: daikinEfficiency[model.slug]?.[s.slug] ? daikinEfficiency[model.slug][s.slug].seer : '',
  scop: daikinEfficiency[model.slug]?.[s.slug] ? daikinEfficiency[model.slug][s.slug].scop : '',
  labelKoelen: daikinEfficiency[model.slug]?.[s.slug] ? coolingLabel(daikinEfficiency[model.slug][s.slug].seer) : '',
  labelVerwarmen: daikinEfficiency[model.slug]?.[s.slug] ? heatingLabel(daikinEfficiency[model.slug][s.slug].scop) : '',
}));

const rows = [
  { icon: 'koelen', label: 'Koelvermogen (nominaal)', value: size.koel ?? 'Op aanvraag', badge: labelKoelen, badgeId: 'val-label-koelen', id: 'val-koel' },
  { icon: 'verwarmen', label: 'Verwarmingsvermogen (nominaal)', value: size.verw ?? 'Op aanvraag', badge: labelVerwarmen, badgeId: 'val-label-verwarmen', id: 'val-verw' },
  { icon: 'ruimte', label: 'Geschikt voor', value: `Ruimtes tot ${size.volume}`, id: 'val-volume' },
  { icon: 'swing', label: 'Vloeroppervlak (vuistregel)', value: size.area, id: 'val-area' },
  { icon: 'rendement', label: 'SEER / SCOP', value: eff ? `${eff.seer} / ${eff.scop}` : `${model.seer} / ${model.scop}`, id: 'val-rendement' },
  { icon: 'wifi', label: 'Bediening', value: 'Afstandsbediening en Onecta-app' },
];

const extra = [
  { label: 'Typeaanduiding', value: model.code },
  { label: 'Koudemiddel', value: 'R32' },
  { label: 'Typische ruimte', value: size.room },
  { label: 'Garantie', value: '5 jaar fabrieksgarantie' },
];

const btnBase = 'size-btn rounded-xl px-5 py-2.5 font-semibold transition ';
const btnActive = 'border-2 border-brand-700 bg-white text-brand-900 shadow-sm';
const btnInactive = 'border border-slate-300 bg-white text-slate-700 hover:border-brand-500 hover:text-brand-900';
const schemaSpecs = acSpecs({
  koel: size.koel, verw: size.verw, seer: eff?.seer, scop: eff?.scop,
  labelKoelen, labelVerwarmen, refrigerant: 'R32', warranty: '5 jaar fabrieksgarantie',
});
---

<BaseLayout
  title={`Daikin ${model.name} ${size.kw} airco | Best Aircotechniek`}
  description={`Daikin ${model.name} ${size.kw}: geschikt voor ${size.room.toLowerCase()} (${size.volume}). Laten installeren vanaf ${site.priceFrom} door Best Aircotechniek.`}
>
  <section class="pt-8 pb-16 sm:pt-10 sm:pb-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-500" aria-label="Kruimelpad">
        <a href="/merken/daikin/" class="hover:text-brand-700">Daikin</a>
        <span class="px-1">/</span>
        <a href={`/merken/daikin/${model.slug}/`} class="hover:text-brand-700">{model.name}</a>
        <span class="px-1">/</span>
        <span id="crumb-size" class="text-slate-700">{size.kw}</span>
      </nav>

      <div class="mt-4">
        <p class="text-sm font-semibold uppercase tracking-wider text-gold-600">{model.tier}</p>
        <h1 id="page-title" class="mt-1 text-3xl font-extrabold tracking-tight text-brand-900 sm:text-4xl">
          Daikin {model.name} {size.kw}
        </h1>
        <p id="page-sub" class="mt-2 text-slate-600">
          Geschikt voor {size.room.toLowerCase()} ({size.volume}).
        </p>
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
        <span class="text-sm font-semibold text-slate-700">Kies uw vermogen</span>
        <div class="flex flex-wrap gap-3">
          {
            model.sizes.map((s) => (
              <a
                href={`/merken/daikin/${model.slug}/${s.slug}/`}
                data-size={s.slug}
                class={btnBase + (s.slug === size.slug ? btnActive : btnInactive)}
              >
                {s.kw}
              </a>
            ))
          }
        </div>
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-stretch">
        <div class="panel flex min-h-[18rem] flex-col items-center justify-center gap-5 bg-gradient-to-br from-brand-50 via-white to-white p-8 lg:col-span-7">
          <img
            src={model.photo}
            alt={`Daikin ${model.name} airconditioner`}
            width="1000"
            height="1000"
            loading="eager"
            class="w-full max-w-[26rem] object-contain"
          />
          <div class="text-center">
            <p id="panel-title" class="text-3xl font-extrabold text-brand-900">{model.name} {size.kw}</p>
            <p class="mt-4 text-sm text-slate-500">Officiële typeaanduiding: {model.code}</p>
          </div>
        </div>

        <div class="panel flex flex-col p-6 sm:p-8 lg:col-span-5">
          <h2 class="section-heading">Specificaties</h2>
          <dl class="mt-6 space-y-4">
            {
              rows.map((r) => (
                <div class="flex items-start gap-3">
                  <img src={`/spec-icons/${r.icon}.png`} alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
                  <div>
                    <dt class="text-sm text-slate-500">{r.label}</dt>
                    <dd class="flex items-center gap-2 font-semibold text-brand-900">
                      <span id={r.id}>{r.value}</span>
                      {r.badge && (
                        <span
                          id={r.badgeId}
                          class={`rounded px-2 py-0.5 text-xs font-bold text-white ${r.badge === 'A+++' ? 'bg-[#00a651]' : r.badge === 'A++' ? 'bg-[#2f9e44]' : 'bg-[#94b820]'}`}
                        >
                          {r.badge}
                        </span>
                      )}
                    </dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="panel mt-8 p-6 sm:p-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="min-w-0 flex-1">
            <h3 class="text-lg font-bold text-brand-900">Meer kenmerken</h3>
            <ul class="mt-4 space-y-2 text-sm">
              {
                extra.map((e) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500" />
                    <span class="text-slate-600">
                      <span class="font-semibold text-brand-900">{e.label}:</span>
                      <span id={e.label === 'Typische ruimte' ? 'val-room' : undefined}>{e.value}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="shrink-0 lg:pl-8">
            <a href="/contact/" class="btn-primary inline-flex w-full justify-center sm:w-auto">Vraag een offerte aan</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title={`Daikin ${model.name} laten installeren?`}
    description={`Best Aircotechniek verzorgt advies, levering en een vakkundige montage vanaf ${site.priceFrom}. Vraag een vrijblijvende offerte aan.`}
  />

  <script
    define:vars={{
      sizesData,
      modelSlug: model.slug,
      modelName: model.name,
      btnBase,
      btnActive,
      btnInactive,
    }}
  >
    const links = Array.from(document.querySelectorAll('a[data-size]'));
    function applySize(slug) {
      const d = sizesData.find((s) => s.slug === slug);
      if (!d) return;
      const setText = (id, text) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };
      setText('val-koel', d.koel);
      setText('val-verw', d.verw);
      setText('val-volume', 'Ruimtes tot ' + d.volume);
      setText('val-area', d.area);
      setText('val-room', ' ' + d.room);
      const paint = (id, v) => {
        const el = document.getElementById(id);
        if (!el || !v) return;
        el.textContent = v;
        el.className = 'rounded px-2 py-0.5 text-xs font-bold text-white ' +
          (v === 'A+++' ? 'bg-[#00a651]' : v === 'A++' ? 'bg-[#2f9e44]' : 'bg-[#94b820]');
      };
      if (d.seer && d.scop) setText('val-rendement', d.seer + ' / ' + d.scop);
      paint('val-label-koelen', d.labelKoelen);
      paint('val-label-verwarmen', d.labelVerwarmen);
      setText('crumb-size', d.kw);
      setText('page-title', 'Daikin ' + modelName + ' ' + d.kw);
      setText('panel-title', modelName + ' ' + d.kw);
      setText('page-sub', 'Geschikt voor ' + d.room.toLowerCase() + ' (' + d.volume + ').');
      links.forEach((a) => {
        a.className = btnBase + (a.dataset.size === slug ? btnActive : btnInactive);
      });
      document.title = 'Daikin ' + modelName + ' ' + d.kw + ' airco | Best Aircotechniek';
      history.replaceState(null, '', '/merken/daikin/' + modelSlug + '/' + slug);
    }
    links.forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        applySize(a.dataset.size);
      }),
    );
  </script>
  <ProductSchema
    name={`Daikin ${model.name} ${size.kw} airconditioner`}
    brand="Daikin"
    sku={model.code}
    description={`Daikin ${model.name} ${size.kw} (${model.code}) wandmodel${size.koel ? `: ${size.koel} koelvermogen en ${size.verw} verwarmingsvermogen` : ''}${eff ? `, SEER ${eff.seer} en SCOP ${eff.scop}` : ''}. Geschikt voor ${size.room.toLowerCase()} tot ${size.volume}, inclusief montage door Best Aircotechniek.`}
    image={model.photo}
    specs={schemaSpecs}
  />
</BaseLayout>
