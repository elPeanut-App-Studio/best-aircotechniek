---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import Carousel from '../../components/Carousel.astro';
import { brands } from '../../data/brands';
import { auxModels } from '../../data/aux-products';
import { lgModels } from '../../data/lg-products';
import { daikinModels } from '../../data/daikin-products';
import heroPhoto from '../../assets/photos/page-hero-woning.jpg';
import PriceSticker from '../../components/PriceSticker.astro';

export function getStaticPaths() {
  return brands.map((b) => ({ params: { brand: b.slug }, props: { brand: b } }));
}

const { brand } = Astro.props;
const modelsByBrand: Record<string, any[]> = {
  aux: auxModels,
  lg: lgModels,
  daikin: daikinModels,
};
const models = modelsByBrand[brand.slug] ?? [];

// Welke kenmerken als bullets op de modelkaart komen, per merk (labels verschillen).
const highlightsByBrand: Record<string, string[]> = {
  aux: ['Luchtstroom & comfort', 'Luchtzuivering', 'Verwarmen bij extreme kou'],
  lg: ['Luchtreiniging', 'Slimme functies', 'Bediening'],
  daikin: ['Uitvoering', 'Beschikbaar in', 'Koudemiddel'],
};
const highlightLabels = highlightsByBrand[brand.slug] ?? [];
/**
 * Kiest maximaal 3 kenmerken voor de modelkaart. De voorkeurslabels per merk
 * gaan voor, maar als een model die niet heeft (de Daikin Perfera heeft
 * bijvoorbeeld geen "Koudemiddel") vullen we aan met zijn overige kenmerken.
 * Zo blijft een kaart nooit met lege bullets achter. De weergave volgt de
 * oorspronkelijke volgorde van het model, want die staat op belangrijkheid.
 */
function highlightsFor(m: { specs?: { label: string; value: string }[]; highlights?: string[] }) {
  // Modellen met een eigen `highlights`-lijst (Daikin) tonen die, zodat de
  // kaarten op dezelfde assen vergelijkbaar zijn.
  if (m.highlights?.length) return m.highlights.map((value) => ({ label: '', value }));
  const specs = m.specs ?? [];
  const preferred = specs.filter((s) => highlightLabels.includes(s.label));
  const rest = specs.filter((s) => !preferred.includes(s));
  const chosen = new Set([...preferred, ...rest].slice(0, 3));
  return specs.filter((s) => chosen.has(s));
}


const intros: Record<string, string> = {
  aux: 'AUX biedt drie series, elk met eigen kenmerken en comfort. Hieronder vindt u per model de belangrijkste functies. Klik door voor de beschikbare vermogens en alle specificaties.',
  lg: 'LG biedt vier wandmodellen, van een voordelig instapmodel tot het zuinigste topmodel. Ze koelen en verwarmen allemaal, werken op R32 en hebben wifi ingebouwd. Hieronder vindt u per model de belangrijkste kenmerken.',
  daikin:
    'Daikin biedt vijf wandmodellen, van het voordelige instapmodel Sensira tot de designmodellen Stylish en Emura. Ze koelen en verwarmen allemaal, werken op R32 en zijn te bedienen met de Onecta-app. Hieronder vindt u per model de belangrijkste kenmerken en de beschikbare vermogens.',
};
const modelsHeadings: Record<string, string> = {
  aux: 'De drie AUX-series',
  lg: 'De vier LG-modellen',
  daikin: 'De vijf Daikin-modellen',
};
const modelsHeading = modelsHeadings[brand.slug] ?? `De ${brand.name}-modellen`;
---

<BaseLayout
  title={`${brand.name} airco laten installeren | Best Aircotechniek`}
  description={`${brand.name} airconditioning laten installeren in Noord-Brabant. ${brand.tagline}`}
>
  <PageHero title={`${brand.name} airconditioning`} description={brand.tagline} image={heroPhoto} />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="gold-accent-line"></div>
      <h2 class="section-heading mt-6">Over {brand.name}</h2>
      {
        models.length > 0 ? (
          <p class="mt-4 text-lg leading-relaxed text-slate-600">{intros[brand.slug]}</p>
        ) : (
          <p class="mt-4 text-lg leading-relaxed text-slate-600">
            Binnenkort vindt u hier meer informatie over de {brand.name}-modellen die wij installeren, met de
            kenmerken en voordelen. Wilt u nu al persoonlijk advies of een vrijblijvende offerte? Neem gerust
            contact met ons op, dan kijken we samen welk model het beste bij uw woning past.
          </p>
        )
      }
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/contact/" class="btn-primary inline-flex">Vraag een offerte aan</a>
        {
          brand.brochure && (
            <a href={brand.brochure} download class="btn-secondary inline-flex items-center gap-2">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              Download de {brand.name}-brochure (pdf)
            </a>
          )
        }
        <a href="/airco-installatie/" class="btn-secondary inline-flex">Bekijk airco-installatie</a>
      </div>
    </div>
  </section>

  {
    models.length > 0 && (
      <section class="border-t border-slate-200 bg-slate-50 py-16 sm:py-20">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <h2 class="section-heading">{modelsHeading}</h2>
          <Carousel
            class="mt-10"
            label={modelsHeading}
            prevLabel="Vorige modellen"
            nextLabel="Volgende modellen"
            gotoLabel="Ga naar modellen"
          >
            {models.map((m) => (
              <a
                href={`/merken/${brand.slug}/${m.slug}/`}
                class="group card-link flex shrink-0 basis-full snap-start flex-col p-6 sm:basis-[calc((100%-2rem)/2)] lg:basis-[calc((100%-6rem)/4)]"
              >
                {
                  m.photo ? (
                    <span class="relative mx-auto block w-fit">
                      <img
                        src={m.photo}
                        alt={`${brand.name} ${m.name} airconditioner`}
                        width="600"
                        height="600"
                        loading="lazy"
                        class="h-40 w-auto object-contain"
                      />
                      {m.priceFrom && <PriceSticker amount={m.priceFrom} class="-right-3 -top-3" />}
                    </span>
                  ) : (
                    <span class="flex h-40 items-center justify-center rounded-xl bg-brand-50">
                      <img src={brand.logo} alt={`${brand.name} logo`} width="160" height="48" loading="lazy" class="h-10 w-auto object-contain" />
                    </span>
                  )
                }
                <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-gold-600">{m.tier}</p>
                <h3 class="mt-1 text-xl font-bold text-brand-900">{brand.name} {m.name}</h3>
                <p class="mt-2 leading-relaxed text-slate-600 sm:min-h-[6.5rem]">{m.intro}</p>
                <ul class="mt-4 space-y-2 text-sm">
                  {highlightsFor(m).map((spec) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true" class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500" />
                      <span class="text-slate-600">{spec.value}</span>
                    </li>
                  ))}
                </ul>
                <span class="mt-auto pt-5 text-sm font-semibold text-brand-700 transition group-hover:text-brand-900">
                  {brand.slug === 'lg' ? 'Bekijk model' : 'Bekijk modellen'}
                  <span aria-hidden="true" class="transition group-hover:translate-x-0.5">&rarr;</span>
                </span>
              </a>
            ))}
          </Carousel>
        </div>
      </section>
    )
  }

  <CTASection />
</BaseLayout>
