---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTASection from '../../../components/CTASection.astro';
import { auxModels, auxSizes, auxShared } from '../../../data/aux-products';
import pageHeroPhoto from '../../../assets/photos/page-hero-woning.jpg';
import PriceSticker from '../../../components/PriceSticker.astro';
import ProductSchema from '../../../components/ProductSchema.astro';
import { acSpecs } from '../../../lib/schema-specs';

export function getStaticPaths() {
  return auxModels.map((model) => ({ params: { model: model.slug }, props: { model } }));
}

const { model } = Astro.props;

// Iconen voor de 5 modelkenmerken (zelfde volgorde als model.specs)
const specIcons = ['swing', 'luchtzuivering', 'zelfreiniging', 'verwarmen', 'design'];
const schemaSpecs = acSpecs({
  seer: model.seer, scop: model.scop,
  labelKoelen: model.labelKoelen, labelVerwarmen: model.labelVerwarmen, warranty: '2 jaar',
});
---

<BaseLayout
  title={`AUX ${model.name} airco laten installeren | Best Aircotechniek`}
  description={`AUX ${model.name}: ${model.intro} Beschikbaar in 2,5 / 3,5 / 5,0 / 7,0 kW. Laten installeren door Best Aircotechniek.`}
>
  <PageHero title={`AUX ${model.name}`} description={model.intro} image={pageHeroPhoto} />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-500" aria-label="Kruimelpad">
        <a href="/merken/aux" class="hover:text-brand-700">AUX</a>
        <span class="px-1">/</span>
        <span class="text-slate-700">{model.name}</span>
      </nav>

      <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-stretch">
        <div class="panel relative min-h-[22rem] overflow-hidden bg-gradient-to-br from-brand-50 via-white to-white lg:col-span-7">
          <img src={model.photo} alt={`AUX ${model.name} airconditioner`} width="900" height="900" loading="eager" class="absolute inset-0 h-full w-full object-cover" />
          <PriceSticker amount={model.priceFrom} size="lg" class="right-5 top-5 sm:right-7 sm:top-7" />
        </div>
        <div class="panel flex flex-col p-6 sm:p-8 lg:col-span-5">
          <p class="text-sm font-semibold uppercase tracking-wider text-gold-600">{model.tier}</p>
          <h2 class="section-heading mt-2">Kenmerken</h2>
          <dl class="mt-6 space-y-4">
            <div class="flex items-start gap-3">
              <img src="/spec-icons/rendement.png" alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
              <div>
                <dt class="text-sm text-slate-500">SEER (tot) / SCOP</dt>
                <dd class="font-semibold text-brand-900">{model.seer} / {model.scop}</dd>
              </div>
            </div>
            {
              model.specs.map((s, i) => (
                <div class="flex items-start gap-3">
                  <img src={`/spec-icons/${specIcons[i]}.png`} alt="" width="24" height="24" class="mt-0.5 h-6 w-6 shrink-0" />
                  <div>
                    <dt class="text-sm text-slate-500">{s.label}</dt>
                    <dd class="font-semibold text-brand-900">{s.value}</dd>
                  </div>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="mt-8 rounded-2xl bg-brand-950 px-6 py-6 text-white shadow-card sm:px-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-gold-400">Standaard bij elke AUX</p>
        <div class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-4">
          {
            auxShared.map((item) => (
              <span class="flex items-start gap-2 text-sm text-brand-100">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-gold-400" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                {item}
              </span>
            ))
          }
        </div>
      </div>

      <h2 class="section-heading mt-16">Beschikbare vermogens</h2>
      <p class="mt-3 text-slate-600">Kies het vermogen dat past bij uw ruimte. Klik door voor alle details.</p>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          auxSizes.map((size) => (
            <a
              href={`/merken/aux/${model.slug}/${size.slug}`}
              class="group card-link flex flex-col p-6"
            >
              <p class="text-2xl font-bold text-brand-900">{size.kw}</p>
              <p class="mt-2 min-h-[2.5rem] text-sm text-slate-600">{size.room}</p>
              <p class="mt-1 text-sm text-slate-500">{size.volume} · {size.area}</p>
              <span class="mt-auto pt-4 text-sm font-semibold text-brand-700 transition group-hover:text-brand-900">
                Bekijk details
                <span aria-hidden="true" class="transition group-hover:translate-x-0.5">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    title={`Interesse in de AUX ${model.name}?`}
    description="Wij adviseren u graag over het juiste vermogen en verzorgen de complete installatie. Vraag een vrijblijvende offerte aan."
  />
  <ProductSchema
    name={`AUX ${model.name} airconditioner`}
    brand="AUX"
    description={`AUX ${model.name}: ${model.intro} Leverbaar in ${auxSizes.length} vermogens, SEER tot ${model.seer} en SCOP ${model.scop}, energielabel ${model.labelKoelen} koelen en ${model.labelVerwarmen} verwarmen.`}
    image={model.photo}
    specs={schemaSpecs}
    priceFrom={model.priceFrom}
  />
</BaseLayout>
