---
import { site, serviceAreas } from '../data/site';
import { getGoogleReviews } from '../lib/google-reviews';
import { manualReviewsData } from '../data/reviews';

// Live Places API-feed indien beschikbaar; anders de handmatige reviews (aggregateRating blijft correct).
const reviewsData = (await getGoogleReviews()) ?? manualReviewsData;

const logoUrl = new URL(site.logo, site.url).href;
const imageUrl = new URL(site.ogImage, site.url).href;

const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HVACBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  description: site.description,
  url: site.url,
  logo: logoUrl,
  image: imageUrl,
  telephone: site.phoneHref,
  email: site.email,
  // Concrete plaatsen i.p.v. één vrije tekst, beter voor lokale relevantie.
  areaServed: serviceAreas.map((place) => ({ '@type': 'City', name: place })),
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Noord-Brabant',
    addressCountry: 'NL',
  },
  taxID: site.btwId,
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'KVK',
    value: site.kvk,
  },
  priceRange: '€€',
  // Vanaf-prijs expliciet in structured data, zodat Google en AI-zoekmachines
  // de instapprijs kunnen tonen. Bedrag komt uit site.priceFromAmount.
  makesOffer: {
    '@type': 'Offer',
    name: 'Airco installatie (single-split 2,5 kW)',
    description:
      'Complete installatie van een single-split airco van 2,5 kW, inclusief btw en montage.',
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: site.priceFromAmount,
      priceCurrency: 'EUR',
      valueAddedTaxIncluded: true,
    },
    availableAtOrFrom: {
      '@type': 'Place',
      name: site.region,
    },
  },
};

if (reviewsData && reviewsData.rating > 0 && reviewsData.totalReviews > 0) {
  schema.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: reviewsData.rating,
    reviewCount: reviewsData.totalReviews,
    bestRating: 5,
    worstRating: 1,
  };
}

// sameAs: Google Maps + Instagram + overige profielen, ontdubbeld en lege waarden eruit.
const sameAs = [site.googleMapsUrl, site.instagram, ...site.sameAs].filter(Boolean);
if (sameAs.length > 0) {
  schema.sameAs = [...new Set(sameAs)];
}

// Openingstijden alleen tonen als ze bevestigd/ingevuld zijn (zie src/data/site.ts).
if (site.openingHours.length > 0) {
  schema.openingHoursSpecification = site.openingHours.map((slot) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: slot.days,
    opens: slot.opens,
    closes: slot.closes,
  }));
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
