---
import type { Lang } from '../i18n/routes';

interface Props {
  lang?: Lang;
}

const { lang = 'nl' } = Astro.props;

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const isConfigured = accessKey && accessKey !== 'your-access-key-here';

/*
 * De sleutel MOET de vorm van een UUID hebben. Op 16 augustus 2026 bleek het
 * formulier al weken stuk omdat er "****************6a10" in het GitHub-secret
 * stond: iemand had de gemaskeerde weergave uit een logregel gekopieerd in
 * plaats van de sleutel zelf. Web3Forms weigerde elke inzending, en de
 * bestaande controle hierboven liet dat door omdat de waarde niet leeg was en
 * niet de placeholder.
 *
 * Een verkeerde sleutel is erger dan geen sleutel: zonder sleutel toont de
 * pagina zichtbaar dat het formulier niet gekoppeld is, met een verkeerde
 * sleutel lijkt alles in orde en verdwijnen aanvragen in het niets. Daarom
 * stopt de build hier, in plaats van een kapot formulier te publiceren.
 */
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
if (isConfigured && !UUID.test(accessKey)) {
  throw new Error(
    `PUBLIC_WEB3FORMS_ACCESS_KEY heeft niet de vorm van een Web3Forms-sleutel (verwacht een UUID van 36 tekens, kreeg ${accessKey.length} tekens eindigend op "${accessKey.slice(-4)}"). ` +
      'Staat er een gemaskeerde waarde met sterretjes in het secret? Zet dan de echte sleutel uit je Web3Forms-dashboard.',
  );
}

const copy = {
  nl: {
    notConfigured: 'Het contactformulier is nog niet gekoppeld. Voeg je Web3Forms access key toe in',
    successTitle: 'Bedankt voor uw bericht',
    successBody: 'Wij hebben uw bericht ontvangen en nemen zo snel mogelijk contact met u op.',
    sendAnother: 'Nog een bericht sturen',
    errorBody:
      'Er ging iets mis bij het versturen. Probeer het opnieuw of neem direct contact op via telefoon of e-mail.',
    // Zichtbaar in de mailbox, zodat duidelijk is in welke taal er teruggemaild moet worden.
    subject: 'Nieuw contactformulier - Best Aircotechniek',
    nameLabel: 'Naam *',
    namePlaceholder: 'Uw naam',
    phoneLabel: 'Telefoon',
    emailLabel: 'E-mail *',
    emailPlaceholder: 'uw@email.nl',
    messageLabel: 'Bericht *',
    messagePlaceholder: 'Vertel ons over uw situatie, bijv. aantal kamers, type woning...',
    submit: 'Verstuur bericht',
    sending: 'Bezig met versturen...',
  },
  en: {
    notConfigured: 'The contact form is not connected yet. Add your Web3Forms access key in',
    successTitle: 'Thank you for your message',
    successBody: 'We have received your message and will get back to you as soon as possible.',
    sendAnother: 'Send another message',
    errorBody:
      'Something went wrong while sending. Please try again, or contact us directly by phone or email.',
    subject: 'New ENGLISH request - Best Aircotechniek',
    nameLabel: 'Name *',
    namePlaceholder: 'Your name',
    phoneLabel: 'Phone',
    emailLabel: 'Email *',
    emailPlaceholder: 'you@email.com',
    messageLabel: 'Message *',
    messagePlaceholder: 'Tell us about your situation, for example the number of rooms and type of home...',
    submit: 'Send message',
    sending: 'Sending...',
  },
}[lang];
---

<div data-contact-form-root>
  {
    !isConfigured && (
      <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800" role="status">
        {copy.notConfigured} <code class="font-mono">.env</code>.
      </div>
    )
  }

  <div
    data-form-success
    hidden
    class="rounded-2xl border border-green-200 bg-green-50 p-8 text-center"
    role="status"
  >
    <span
      class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-green-100 text-green-700"
      aria-hidden="true"
    >
      <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
    </span>
    <h3 class="mt-4 text-xl font-bold text-green-900">{copy.successTitle}</h3>
    <p class="mt-2 text-green-800">
      {copy.successBody}
    </p>
    <button type="button" data-form-reset class="btn-secondary mt-6">
      {copy.sendAnother}
    </button>
  </div>

  <div
    data-form-error
    hidden
    class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800"
    role="alert"
  >
    {copy.errorBody}
  </div>

  <form data-contact-form class="space-y-6">
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value={copy.subject} />
    <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <label for="name" class="mb-2 block text-sm font-medium text-slate-700">{copy.nameLabel}</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm shadow-sm transition focus:border-brand-800 focus:outline-none focus:ring-2 focus:ring-gold-400/30"
          placeholder={copy.namePlaceholder}
        />
      </div>
      <div>
        <label for="phone" class="mb-2 block text-sm font-medium text-slate-700">{copy.phoneLabel}</label>
        <input
          type="tel"
          id="phone"
          name="phone"
          class="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm shadow-sm transition focus:border-brand-800 focus:outline-none focus:ring-2 focus:ring-gold-400/30"
          placeholder="+31 6 28305341"
        />
      </div>
    </div>

    <div>
      <label for="email" class="mb-2 block text-sm font-medium text-slate-700">{copy.emailLabel}</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm shadow-sm transition focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
        placeholder={copy.emailPlaceholder}
      />
    </div>

    <div>
      <label for="message" class="mb-2 block text-sm font-medium text-slate-700">{copy.messageLabel}</label>
      <textarea
        id="message"
        name="message"
        required
        rows="5"
        class="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm shadow-sm transition focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
        placeholder={copy.messagePlaceholder}
      ></textarea>
    </div>

    <button type="submit" class="btn-primary w-full sm:w-auto" disabled={!isConfigured} data-submit-btn>
      {copy.submit}
    </button>
  </form>
</div>

<script define:vars={{ submitLabel: copy.submit, sendingLabel: copy.sending }}>
  function initContactForm(root) {
    const form = root.querySelector('[data-contact-form]');
    const success = root.querySelector('[data-form-success]');
    const error = root.querySelector('[data-form-error]');
    const resetBtn = root.querySelector('[data-form-reset]');
    const submitBtn = root.querySelector('[data-submit-btn]');

    if (!form) return;

    function showForm() {
      form.hidden = false;
      if (success) success.hidden = true;
      if (error) error.hidden = true;
    }

    function showSuccess() {
      form.reset();
      form.hidden = true;
      if (error) error.hidden = true;
      if (success) {
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    function showError() {
      if (error) {
        error.hidden = false;
        error.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    resetBtn?.addEventListener('click', showForm);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (error) error.hidden = true;

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = sendingLabel;
      }

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          showSuccess();
        } else {
          showError();
        }
      } catch {
        showError();
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = submitLabel;
        }
      }
    });
  }

  document.querySelectorAll('[data-contact-form-root]').forEach((root) => initContactForm(root));
</script>
