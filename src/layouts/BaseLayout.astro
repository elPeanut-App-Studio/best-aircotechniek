---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import { getImage } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/site';
import { counterpart, normalizePath, type Lang, withTrailingSlash } from '../i18n/routes';

interface Props {
  /**
   * Volledige, SEO-geoptimaliseerde paginatitel. Bevat de titel bij voorkeur
   * al de merknaam; zo niet, dan wordt `| Best Aircotechniek` automatisch
   * toegevoegd. Houd titels onder ~60 tekens voor volledige weergave in Google.
   */
  title: string;
  description?: string;
  /** Taal van de pagina. Default 'nl', zodat bestaande pagina's ongewijzigd blijven. */
  lang?: Lang;
}

const { title, description = site.description, lang = 'nl' } = Astro.props;

// Tegenhanger in de andere taal, voor hreflang. Geen paar betekent geen tags.
//
// De routekaart bewaart paden ZONDER afsluitende slash, want normalizePath haalt
// die weg om te kunnen opzoeken. De site levert pagina's uit MET slash: de
// slash-loze variant geeft een 301. hreflang moet naar de canonieke URL wijzen,
// dus zetten we de slash hier terug. Zonder dat wees elke hreflang-tag naar een
// redirect, wat Google aanleiding geeft de taalkoppeling te negeren.
const selfPath = normalizePath(Astro.url.pathname);
const pair = counterpart(Astro.url.pathname);
const nlHref = lang === 'nl' ? selfPath : (pair?.path ?? null);
const enHref = lang === 'en' ? selfPath : (pair?.path ?? null);
const hasPair = Boolean(nlHref && enHref);
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

const ogImageUrl = new URL(site.ogImage, site.url).href;

const isHome = Astro.url.pathname === '/';
const heroLogo = isHome
  ? await getImage({ src: logo, width: 640, height: 640, format: 'webp' })
  : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap"
      />
    </noscript>
    {
      heroLogo && (
        <link rel="preload" as="image" href={heroLogo.src} type="image/webp" fetchpriority="high" />
      )
    }
    {/*
      Faviconset uit scripts/make-favicons.py: een uitsnede van het binnenwerk
      van het echte logo. Verwees eerder naar site.logo, en dat bestand was
      2048x2048 en 5 MB: elke bezoeker downloadde 5 MB voor een icoontje van 32
      pixels. site.logo blijft in gebruik als logo in de schema-markup, waar een
      groter formaat wel zin heeft.

      Geen favicon.svg: de SVG die in de repo stond was een vereenvoudigde
      natekening en geen echt logo, en browsers geven een SVG voorrang boven de
      PNG. Zodra er een echte vector van het logo is, komt die hier terug.
    */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={`${site.url}${withTrailingSlash(Astro.url.pathname)}`} />
    {
      hasPair && (
        <>
          <link rel="alternate" hreflang="nl" href={new URL(withTrailingSlash(nlHref!), site.url).href} />
          <link rel="alternate" hreflang="en" href={new URL(withTrailingSlash(enHref!), site.url).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(withTrailingSlash(nlHref!), site.url).href} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site.url}${Astro.url.pathname}`} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'nl_NL'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{fullTitle}</title>
    <LocalBusinessSchema />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppButton />
  </body>
</html>
